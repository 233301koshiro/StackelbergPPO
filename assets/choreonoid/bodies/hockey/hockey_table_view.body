format: ChoreonoidBody
format_version: 2.0
angle_unit: degree
name: hockey_table_view

# ⚠️ **自動生成物。手で編集しないこと**（`make_hockey_court_xml.py --wall` が上書きする）。
# ⚠️ **表示専用で、物理には一切入らない。** 学習が使うのは
#    `assets/mujoco_envs/e2e_hockey_wall.xml` であり、**そちらが正**。
# 寸法は XML と同じ定数から出しているのでズレない（9-58）。
#
#   choreonoid data/test/hockey/e2e_hockeyv.urdf \
#     assets/choreonoid/bodies/hockey/hockey_table_view.body

root_link: table_base

links:
  -
    name: table_base
    joint_type: fixed
    translation: [ 0.8500, 0, 0.1625 ]
    mass: 50.0
    center_of_mass: [ 0, 0, 0 ]
    inertia: [ 10, 0, 0, 0, 10, 0, 0, 0, 10 ]
    elements:
      -
        type: Shape
        translation: [ 0.0000, 0.0000, -0.0050 ]
        geometry: { type: Box, size: [ 1.4000, 1.0200, 0.0100 ] }
        appearance: { material: { diffuse: [ 0.85, 0.90, 0.95 ] } }   # surface
      -
        type: Shape
        translation: [ 0.0000, 0.4800, 0.0500 ]
        geometry: { type: Box, size: [ 1.4000, 0.0600, 0.1200 ] }
        appearance: { material: { diffuse: [ 0.35, 0.35, 0.40 ] } }   # wall_side_p
      -
        type: Shape
        translation: [ 0.7300, 0.3300, 0.0500 ]
        geometry: { type: Box, size: [ 0.0600, 0.3600, 0.1200 ] }
        appearance: { material: { diffuse: [ 0.35, 0.35, 0.40 ] } }   # wall_goal_p
      -
        type: Shape
        translation: [ 0.0000, -0.4800, 0.0500 ]
        geometry: { type: Box, size: [ 1.4000, 0.0600, 0.1200 ] }
        appearance: { material: { diffuse: [ 0.35, 0.35, 0.40 ] } }   # wall_side_m
      -
        type: Shape
        translation: [ 0.7300, -0.3300, 0.0500 ]
        geometry: { type: Box, size: [ 0.0600, 0.3600, 0.1200 ] }
        appearance: { material: { diffuse: [ 0.35, 0.35, 0.40 ] } }   # wall_goal_m
      -
        type: Shape
        translation: [ 0.1000, 0.0000, 0.0500 ]
        geometry: { type: Box, size: [ 0.0600, 0.2100, 0.1200 ] }
        appearance: { material: { diffuse: [ 0.20, 0.40, 0.90 ] } }   # goal_board
      -
        type: Shape
        translation: [ 0.7300, 0.0000, 0.0000 ]
        geometry: { type: Box, size: [ 0.0600, 0.3000, 0.0060 ] }
        appearance: { material: { diffuse: [ 0.90, 0.20, 0.20 ] } }   # goal_mouth
