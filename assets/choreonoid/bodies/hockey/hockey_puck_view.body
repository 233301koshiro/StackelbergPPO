format: ChoreonoidBody
format_version: 2.0
angle_unit: degree
name: hockey_puck_view

# ⚠️ **自動生成物。手で編集しないこと**（`make_hockey_court_xml.py --wall` が上書きする）。
# ⚠️ **表示専用。** 物理側の実体は `e2e_hockey_wall.xml` の body `cube`。
# ⚠️ **形は箱である。** 実物のパックは円盤だが、物理が箱なので見た目も箱にする
#    （円盤で描くと当たる瞬間が嘘になる。9-37 で一度その案を出して撤回した）。

root_link: puck

links:
  -
    name: puck
    joint_type: free
    translation: [ 0.5500, 0.0000, 0.2125 ]
    mass: 0.0300
    center_of_mass: [ 0, 0, 0 ]
    inertia: [ 5.0e-05, 0, 0, 0, 5.0e-05, 0, 0, 0, 5.0e-05 ]
    elements:
      -
        type: Shape
        geometry: { type: Box, size: [ 0.1000, 0.1000, 0.1000 ] }
        appearance: { material: { diffuse: [ 0.85, 0.15, 0.15 ] } }
