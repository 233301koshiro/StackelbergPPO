{
  "name": "StackelbergPPO (akita_sp + Claude Code)",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // 実イメージ名（2026-08-28 に docker inspect で確認）
      "BASE_IMAGE": "akita_sp",
      "NODE_MAJOR": "22"
    }
  },

  // 実行ユーザーは root のまま（既存の研究環境と /root/.claude に合わせる）
  "containerUser": "root",
  "remoteUser": "root",

  // ⚠️ /userdir には StackelbergPPO 以外のプロジェクトも同居している
  //    （TA_assembler・dataset・dnn_weight 等）。リポジトリだけをマウントすると
  //    それらが見えなくなるので、**/userdir 全体**をマウントして作業フォルダだけ絞る。
  //    ホスト側パスは稼働中コンテナの Mounts から取得した実値。
  "workspaceFolder": "/userdir/StackelbergPPO",
  "workspaceMount": "source=/home/irsl/irsl_docker_irsl_system/userdir,target=/userdir,type=bind,consistency=cached",

  "mounts": [
    // Choreonoid の GUI・可視化に必要（DISPLAY=:1 のソケット）
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/sys/fs/cgroup,target=/sys/fs/cgroup,type=bind,readonly",
    // Claude Code の設定・履歴はコンテナの書き込み層にあるため、
    // 名前付きボリュームに逃がしてリビルドを跨いで保持する。
    // 初回はからっぽなので、既存の内容を戻すこと（.devcontainer/README.md 参照）。
    "source=stackelbergppo-claude-home,target=/root/.claude,type=volume"
  ],

  // ⚠️ 稼働中コンテナの HostConfig から写した実値。**削ると動かなくなるものがある**。
  //    network=host: ROS が ROS_MASTER_URI=http://localhost:11311 前提
  //    privileged / cap-add / seccomp: 研究室イメージ irsl_system の前提
  //    shm-size は既定（64MB）のまま。稼働実績があるので変更しない
  "runArgs": [
    "--network", "host",
    "--privileged",
    "--cap-add", "SYS_ADMIN",
    "--security-opt", "seccomp=unconfined",
    "--security-opt", "label=disable",
    "--gpus", "all"
  ],

  // 稼働中コンテナの Config.Env から、**再現が必要なものだけ**を写した。
  // PATH・LD_LIBRARY_PATH・PYTHONPATH 等はイメージ側で定義済みなので上書きしない。
  "containerEnv": {
    "DISPLAY": ":1",
    "QT_X11_NO_MITSHM": "1",
    "ROS_IP": "localhost",
    "ROS_MASTER_URI": "http://localhost:11311",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics,display"
  },

  // ビルド時にできない手順（プラグイン導入・認証が絡むもの）はここで回す。
  // 失敗してもコンテナ作成は成功する（fail soft）。再実行は
  //   bash .devcontainer/post-create.sh
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
