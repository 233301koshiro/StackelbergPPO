{
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(bash scripts/audit_runs.sh *)",
      "Bash(bash /userdir/StackelbergPPO/scripts/audit_runs.sh *)",
      "Bash(nvidia-smi *)",
      "Bash(git add *)",
      "Bash(break)",
      "Bash(sed -n '/診断レポート:/,$p' single_run/diag_validation/tripo_pjp_long.txt)",
      "Bash(grep -vE \"^\\\\s*$\")"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf single_run*)",
      "Bash(rm -rf /userdir/StackelbergPPO/single_run*)",
      "Bash(rm -r single_run*)",
      "Bash(rm -rf data/test*)",
      "Bash(rm -rf /userdir/StackelbergPPO/data*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-/userdir/StackelbergPPO}\" && { find docs scripts figures -user root -exec chown ubuntu:ubuntu {} + ; find . -maxdepth 1 -name '*.md' -user root -exec chown ubuntu:ubuntu {} + ; } 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
