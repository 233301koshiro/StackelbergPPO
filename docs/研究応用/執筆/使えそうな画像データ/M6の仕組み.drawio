        <mxCell id="p6_ce" edge="1" parent="1" source="p6_c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_d" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_de" edge="1" parent="1" source="p6_d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_f" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_bt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="体の番号は、名前 0・1・11・111 を 5 進数として読んだ数。名前はリンク1からの道筋なので、&lt;b&gt;どのリンクか&lt;/b&gt;をこれで区別する。アームは1本道なのであんま関係ないけど4本足まで可能ということ。0は台座(root)以外にはつかない。" vertex="1">
          <mxGeometry height="65" width="295" x="960" y="480" as="geometry" />
        </mxCell>
        <mxCell id="p6_ct" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="注意は全行のあいだに張る（木の辺では制限しない）。木の形は番号の埋め込みと深さから入る。&lt;br&gt;&lt;b&gt;行の数が変わっても同じ重みで扱える&lt;/b&gt; → 生成メッシュ由来の腕を書き換えずに受理できた（修論 3.3）" vertex="1">
          <mxGeometry height="92" width="295" x="960" y="552" as="geometry" />
        </mxCell>
        <mxCell id="p6_dt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="台座の行の出力は捨てる（&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; text-align: center;&quot;&gt;μ&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); text-align: center;&quot;&gt;&lt;sub&gt;0&lt;/sub&gt;&lt;/span&gt;関節が無い）。&lt;br&gt;σ (ゆらぎの大きさ)は全関節で共通の 1 つの値を学習する（初期 e&lt;sup&gt;−0.5&lt;/sup&gt; ≈ 0.61）。&lt;br&gt;初期のμはほぼ0なのでほとんどこいつの値&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="295" x="960" y="665" as="geometry" />
        </mxCell>
        <mxCell id="p6_R3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=12;" value="&lt;b&gt;段ごとに別のネットワーク（方策 3 本・価値関数 3 本）&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="590" x="675" y="780" as="geometry" />
        </mxCell>
        <mxCell id="p6_th0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;段&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="125" x="690" y="808" as="geometry" />
        </mxCell>
        <mxCell id="p6_th1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;方策&lt;font style=&quot;font-size: 16px;&quot;&gt;（入力 &lt;/font&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;→&lt;/font&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt; 出力）&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="275" x="820" y="808" as="geometry" />
        </mxCell>
        <mxCell id="p6_th2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;価値関数&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="165" x="1100" y="808" as="geometry" />
        </mxCell>
        <mxCell id="p6_tc0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" value="骨格の段&lt;br&gt;（本研究は素通り）" vertex="1">
          <mxGeometry height="38" width="125" x="690" y="837" as="geometry" />
        </mxCell>
        <mxCell id="p6_tp0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="7 → 3 択（足す・消す・そのまま）" vertex="1">
          <mxGeometry height="38" width="275" x="820" y="837" as="geometry" />
        </mxCell>
        <mxCell id="p6_tv0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=10;" value="24 → V" vertex="1">
          <mxGeometry height="38" width="165" x="1100" y="837" as="geometry" />
        </mxCell>
        <mxCell id="p6_tc1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="形の段&lt;br&gt;Leader" vertex="1">
          <mxGeometry height="38" width="125" x="690" y="879" as="geometry" />
        </mxCell>
        <mxCell id="p6_tp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="7 ⇒ 行ごとに編集量 3 つ&lt;br&gt;（σ の初期 e&lt;sup&gt;−2.3&lt;/sup&gt; ≈ 0.10）" vertex="1">
          <mxGeometry height="38" width="275" x="820" y="879" as="geometry" />
        </mxCell>
        <mxCell id="p6_tv1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=10;" value="24 → V" vertex="1">
          <mxGeometry height="38" width="165" x="1100" y="879" as="geometry" />
        </mxCell>
        <mxCell id="p6_tc2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="実行の段&lt;br&gt;Follower" vertex="1">
          <mxGeometry height="38" width="125" x="690" y="921" as="geometry" />
        </mxCell>
        <mxCell id="p6_tp2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="24 ⇒ 行ごとに指令μ 1 つ" vertex="1">
          <mxGeometry height="38" width="275" x="820" y="921" as="geometry" />
        </mxCell>
        <mxCell id="p6_tv2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=10;" value="24 → V" vertex="1">
          <mxGeometry height="38" width="165" x="1100" y="921" as="geometry" />
        </mxCell>
        <mxCell id="p6_R4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#fafafa;strokeColor=#b3b3b3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" value="&lt;b&gt;② 直すときの使われ方&lt;/b&gt;（1 ページ目の ②）&lt;br&gt;&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;価値関数 V が「この状態からあとどれだけ稼げるか」を予測&lt;/b&gt;し、実際のリターンとの差（アドバンテージ。GAE、γ 0.995・λ 0.95）で行動の良し悪しを測る。Follower は PPO（クリップ 0.2・1 エポックに 10 回・ミニバッチ 2048）、Leader は PPO ＋ Stackelberg 勾配（ダンピング 5）。学習率は方策 5×10&lt;sup&gt;−5&lt;/sup&gt;・価値関数 3×10&lt;sup&gt;−4&lt;/sup&gt;（修論 付録D 表 D.1）" vertex="1">
          <mxGeometry height="105" width="590" x="675" y="1005" as="geometry" />
        </mxCell>
        <mxCell id="p6_k1" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;要点 1　報酬は「押しの項 1 つ ＋ 制御コスト」だけ&lt;/b&gt;&lt;br&gt;タスクで違うのは押しの項だけ。到達（Reach）では −‖腕の先 − 目標‖ に替わり、制御コストとネットワークは同じ（修論 4.1.2）" vertex="1">
          <mxGeometry height="120" width="410" x="20" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="p6_k2" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;要点 2　形の点数は Follower の成績そのもの&lt;/b&gt;&lt;br&gt;形の段の報酬は 0 なので、Leader は「その形で Follower がどれだけ押せたか」だけで直される。だから学習を形の判定器として使える（修論 3.1）" vertex="1">
          <mxGeometry height="120" width="410" x="445" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="p6_k3" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;要点 3　Follower は形を見ながら動かす&lt;/b&gt;&lt;br&gt;観測の各行に形の値（太さ・ギア比など）が入るので、形が変わると同じ観測でも出す指令が変わる。1 つのネットワークで、Leader が試すどの形も動かせる" vertex="1">
          <mxGeometry height="120" width="410" x="870" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="m5WXB3iabB_e8-5kXgR2-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="↑縦型アームはここに&lt;br&gt;長さが入るよん" vertex="1">
          <mxGeometry height="30" width="145" x="1110" y="343" as="geometry" />
        </mxCell>
        <mxCell id="m5WXB3iabB_e8-5kXgR2-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="38" width="260.72" x="960" y="635" as="geometry" />
        </mxCell>
        <mxCell id="iGOGRwPaU00nWwPQeUja-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="先行研究では関節を足したり消したりするとこだけど本研究では素通りなので無視" vertex="1">
          <mxGeometry height="20" width="565" x="687.5" y="847" as="geometry" />
        </mxCell>
        <mxCell id="iGOGRwPaU00nWwPQeUja-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;その話の最後までの報酬を割引なしで全部足したもの。形の段の報酬は 0 なので、実質は Follower が稼いだ合計&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="255" x="1270" y="920" as="geometry" />
        </mxCell>
        <mxCell id="iGOGRwPaU00nWwPQeUja-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;実際に得た報酬と、V 自身の&lt;/span&gt;&lt;br style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;「次の状態の予測」を混ぜたもの&lt;/span&gt;&lt;br style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;（GAE。γ 0.995・λ 0.95）&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="255" x="1270" y="878" as="geometry" />
        </mxCell>
        <mxCell id="iGOGRwPaU00nWwPQeUja-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="価値関数Vが学ぶ正解" vertex="1">
          <mxGeometry height="75" width="62" x="1525" y="880" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
