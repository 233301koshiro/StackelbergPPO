          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gtick" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="1 tick の中（左から右へ）">
          <mxGeometry x="20" y="280" width="1260" height="390" as="geometry" />
        </mxCell>
        <mxCell id="eb" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;tick の前（env）&lt;/b&gt;&lt;br&gt;・トルクを書く&lt;br&gt;　指令 × ギア比&lt;br&gt;・関節の減衰&lt;br&gt;　−b·q̇ をトルクに足す&lt;br&gt;（AIST は減衰を扱わない）">
          <mxGeometry x="35" y="335" width="205" height="200" as="geometry" />
        </mxCell>
        <mxCell id="gaist" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#eef7ec;" value="AIST の 1 tick（Choreonoid の中の物理エンジン）">
          <mxGeometry x="265" y="315" width="730" height="340" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;① 当たり判定（衝突検出）&lt;/b&gt;&lt;br&gt;重なっている組を探し、&lt;br&gt;接触点と深さを出す&lt;br&gt;&lt;br&gt;調べる組:&lt;br&gt;・腕 × 床、腕 × 箱、箱 × 床&lt;br&gt;・腕どうし（隣り合わない組だけ。&lt;br&gt;　&lt;span style=&quot;background:#fff2cc&quot;&gt;自己干渉を足した&lt;/span&gt;）&lt;br&gt;&lt;br&gt;形はメッシュとして扱われる&lt;br&gt;（Coldet）">
          <mxGeometry x="280" y="355" width="225" height="285" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;② 接触の力（拘束ソルバー）&lt;/b&gt;&lt;br&gt;めり込みを押し戻す力と&lt;br&gt;摩擦の力を、反復で決める&lt;br&gt;（上限 25 回）&lt;br&gt;&lt;br&gt;・摩擦係数 0.5（既定）&lt;br&gt;・跳ね返り 0（扱えない）&lt;br&gt;・深すぎる接触は捨てる:&lt;br&gt;　&lt;span style=&quot;background:#fff2cc&quot;&gt;0.05 m → 1.0 m に変えた&lt;br&gt;　（Bug 57）&lt;/span&gt;">
          <mxGeometry x="520" y="355" width="225" height="285" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;③ 運動の積分&lt;/b&gt;&lt;br&gt;トルク ＋ 接触の力から&lt;br&gt;加速度を出し、&lt;br&gt;&lt;b&gt;速度を更新 → その速度で&lt;br&gt;位置を進める&lt;/b&gt;&lt;br&gt;（半陰的オイラー）&lt;br&gt;&lt;br&gt;刻みが粗いと、速い物は&lt;br&gt;1 tick で深く入る">
          <mxGeometry x="760" y="355" width="220" height="285" as="geometry" />
        </mxCell>
        <mxCell id="ea" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;tick の後（env）&lt;/b&gt;&lt;br&gt;・関節の速さの上限で切る&lt;br&gt;　（位置も進め直す。Bug 65）&lt;br&gt;・可動域で止める&lt;br&gt;　（AIST は守らない）&lt;br&gt;・壁の跳ね返り（ホッケー）">
          <mxGeometry x="1020" y="335" width="245" height="185" as="geometry" />
        </mxCell>
        <mxCell id="sync" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=11;" value="&lt;b&gt;tick が終わるのを待つ&lt;/b&gt;&lt;br&gt;（&lt;span style=&quot;background:#fff2cc&quot;&gt;CNOID_TICK_SYNC&lt;/span&gt;）&lt;br&gt;待たないと、計算中の状態を env が読み書きし、物理が毎回ずれていた（Bug 64）">
          <mxGeometry x="1020" y="530" width="245" height="125" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="1" edge="1" source="eb" target="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="1" edge="1" source="f1" target="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="接触点&lt;br&gt;と深さ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="1" edge="1" source="f2" target="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="接触の&lt;br&gt;力">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="1" edge="1" source="f3" target="ea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" value="新しい角度&lt;br&gt;・速さ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gfail" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="「床にめり込む」「すり抜ける」は、どこの失敗でありうるか">
          <mxGeometry x="20" y="700" width="1260" height="330" as="geometry" />
        </mxCell>
        <mxCell id="m1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;① の失敗：接触が返らない&lt;/b&gt;&lt;br&gt;当たり判定が重なりを見つけないと、力が出ず、そのまま通り抜ける。&lt;br&gt;&lt;br&gt;&lt;b&gt;四脚の脛 × 床（Bug 103）&lt;/b&gt;: 床の下にある場面の 50〜76 % で接触点が 1 つも無かった。0.5 m 角の箱を敷いた床では減る。反復の上限や捨てる深さを変えても件数は変わらない → 力ではなく判定の側。仕組みは未特定">
          <mxGeometry x="35" y="740" width="300" height="275" as="geometry" />
        </mxCell>
        <mxCell id="m2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;② の失敗：返った接触を捨てる&lt;/b&gt;&lt;br&gt;深すぎる接触をソルバーが無視すると、押し戻されないまま重なりが残る。&lt;br&gt;&lt;br&gt;&lt;b&gt;押しの長い腕（Bug 57）&lt;/b&gt;: 1 step に 5 cm を越えて台座へめり込み、捨てられて 175 mm すり抜けたまま強く打っていた。閾値を 1.0 m にして取り直した">
          <mxGeometry x="345" y="740" width="300" height="275" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;③ の失敗：1 tick で動きすぎる&lt;/b&gt;&lt;br&gt;刻みが粗いと、速く当たったときに 1 tick で深く入ってから押し戻される。薄い物は一度に通り抜けうる（想定問答 Q22 の限界）。&lt;br&gt;&lt;br&gt;&lt;b&gt;軸6 の 1/5 の腕&lt;/b&gt;: 刻みを 0.0025 s にすると、速く床に当たったときのめり込みが −10.5 → −1.1 mm（系譜 9-327）">
          <mxGeometry x="655" y="740" width="300" height="275" as="geometry" />
        </mxCell>
        <mxCell id="m4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;極端な食い込み：値が壊れる&lt;/b&gt;&lt;br&gt;太いリンクが静的な箱に深く食い込むと、1 tick の中で状態が NaN になった。&lt;br&gt;&lt;br&gt;&lt;b&gt;ホッケーの板（Bug 68）&lt;/b&gt;: 板だけを 3 m 上へ動かすと 5 話とも有限に戻った。NaN は検査で必ず拾う（不変条件）">
          <mxGeometry x="965" y="740" width="300" height="275" as="geometry" />
        </mxCell>
        <mxCell id="mf1" parent="1" edge="1" source="m1" target="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mf2" parent="1" edge="1" source="m2" target="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.34;entryY=1;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mf3" parent="1" edge="1" source="m3" target="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　1 step（0.04 s）のあいだに、物理エンジンは何回、何をするか&lt;/b&gt;&lt;br&gt;4 回。毎回 ① 当たり判定 → ② 接触の力 → ③ 積分。その前に env がトルクと減衰を書き、後に速さ・可動域で切る（橙）">
          <mxGeometry x="20" y="1060" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　「床にめり込む」はどちらの失敗か。四脚は？&lt;/b&gt;&lt;br&gt;判定（①）と力（②）のどちらでもありうる。四脚は判定の側: 接触点が 1 つも返っておらず、力の設定を変えても件数が同じだった（Bug 103）">
          <mxGeometry x="445" y="1060" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;審査での言い方&lt;/b&gt;&lt;br&gt;当たり判定・接触の力・積分の作りは AIST のまま。値を変えたのは、腕どうしの当たり判定を足したことと、深い接触を捨てない閾値の 2 つ（値の変更表 §2）。ほかに tick の完了を待つようにした（Bug 64）。黄色がこの 3 つ">
          <mxGeometry x="870" y="1060" width="410" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="m6_values" name="5 層 G モデルの値">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1040" math="0" shadow="0">
      <root>
