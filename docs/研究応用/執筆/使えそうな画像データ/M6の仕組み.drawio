        <mxCell id="o_obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;観測（方策へ返すもの、リンクごと）&lt;/b&gt;&lt;br&gt;・関節の角度・角速度&lt;br&gt;・箱と先端の相対位置（根元のノード）&lt;br&gt;・いまの形の値（長さ・太さ・ギア比）&lt;br&gt;・木の構造（深さ・つながり）" vertex="1">
          <mxGeometry height="175" width="290" x="35" y="900" as="geometry" />
        </mxCell>
        <mxCell id="o_rew" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;報酬（タスクで違うのは主にここ）&lt;/b&gt;&lt;br&gt;&lt;b&gt;到達&lt;/b&gt;: −（先端と目標の距離）&lt;br&gt;　　− 0.2 × 指令² の平均&lt;br&gt;&lt;b&gt;押し&lt;/b&gt;: 箱の x の速さ − 0.1 × |y の速さ|&lt;br&gt;　　− 0.2 × 指令² の平均&lt;br&gt;&lt;b&gt;形の段&lt;/b&gt;: 0" vertex="1">
          <mxGeometry height="175" width="290" x="340" y="900" as="geometry" />
        </mxCell>
        <mxCell id="o_done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;話が終わる条件&lt;/b&gt;&lt;br&gt;・実行が 1000 step に達した（40 秒ぶん）&lt;br&gt;・状態の値が壊れた（NaN など）&lt;br&gt;・③ の門に当たった" vertex="1">
          <mxGeometry height="175" width="290" x="645" y="900" as="geometry" />
        </mxCell>
        <mxCell id="o_phys" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;env が物理エンジンの外で足しているもの&lt;/b&gt;&lt;br&gt;・指令を ±1 で切る&lt;br&gt;・関節の減衰 −b·q̇&lt;br&gt;・関節の速さの上限&lt;br&gt;・可動域（Choreonoid は守らない）&lt;br&gt;・壁の跳ね返り（ホッケーだけ。&lt;br&gt;　AIST は跳ね返りを扱えない）" vertex="1">
          <mxGeometry height="175" width="285" x="950" y="900" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　報酬を変えるのと物理を変えるのは、どちらが env の仕事か&lt;/b&gt;&lt;br&gt;報酬は env の仕事（左から 2 つ目の箱）。物理の大半は AIST が計算するが、右端の箱の分だけは env が毎 tick 手で足している" vertex="1">
          <mxGeometry height="115" width="400" x="20" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　壁の跳ね返りを env で計算するとは&lt;/b&gt;&lt;br&gt;AIST は跳ね返りを 0 として扱うので、tick の後にパックの速度を反射させて書き戻す。修論には「壁との接触は物理エンジンではなく速度反射としてモデル化した」と書く" vertex="1">
          <mxGeometry height="115" width="400" x="435" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;くじについて&lt;/b&gt;&lt;br&gt;どの話も ③ のずれのくじ 1 本。くじの種は run の seed で固定されるので、再生すると同じ順に同じくじが出る（話を増やして分布で見る理由）" vertex="1">
          <mxGeometry height="115" width="400" x="850" y="1120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
