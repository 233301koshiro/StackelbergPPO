          <mxGeometry height="56" width="130" x="295" y="350" as="geometry" />
        </mxCell>
        <mxCell id="p6_t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="実行の段 最大 1000 step&lt;br&gt;毎 step &lt;b&gt;r&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;（下の式）" vertex="1">
          <mxGeometry height="56" width="170" x="445" y="350" as="geometry" />
        </mxCell>
        <mxCell id="p6_te0" edge="1" parent="1" source="p6_t0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_t1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_te1" edge="1" parent="1" source="p6_t1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_t2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_te2" edge="1" parent="1" source="p6_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_t3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_L2t" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="形の段の報酬は 0。Leader の点数は、右端の実行の段で Follower が稼いだ分の和だけで決まる（下の「Leader の報酬」）" vertex="1">
          <mxGeometry height="34" width="570" x="45" y="410" as="geometry" />
        </mxCell>
        <mxCell id="p6_L3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=12;" value="&lt;b&gt;実行の段の 1 step の報酬 r&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="290" width="590" x="35" y="465" as="geometry" />
        </mxCell>
        <mxCell id="p6_eq" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#333333;" value="&lt;span style=&quot;font-size:16px&quot;&gt;r&lt;sub&gt;t&lt;/sub&gt; ＝ &lt;span style=&quot;background-color:#fff2cc&quot;&gt;(Δx&lt;sub&gt;箱&lt;/sub&gt; − 0.1·|Δy&lt;sub&gt;箱&lt;/sub&gt;|) ／ Δt&lt;/span&gt;　−　&lt;span style=&quot;background-color:#dae8fc&quot;&gt;0.2 × (u&lt;sub&gt;1&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + u&lt;sub&gt;2&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + u&lt;sub&gt;3&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + 0 + 0) ／ 5&lt;/span&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="580" x="40" y="495" as="geometry" />
        </mxCell>
        <mxCell id="p6_eqA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;押しの項&lt;/b&gt;（タスクで違うのはここだけ）&lt;br&gt;1 step のあいだに箱が x へ進んだ距離 ÷ Δt ＝ &lt;b&gt;箱の前への速さ&lt;/b&gt;。横へずれた分は 0.1 倍して引く。&lt;br&gt;Δt ＝ 0.04 s（1 tick 0.01 s × 4 tick。2 ページ目 ④ の (3)）&lt;br&gt;箱の位置は物理を 4 tick 進める前と後で読む" vertex="1">
          <mxGeometry height="190" width="280" x="45" y="555" as="geometry" />
        </mxCell>
        <mxCell id="p6_eqB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;制御コスト&lt;/b&gt;（どのタスクも同じ）&lt;br&gt;u&lt;sub&gt;j&lt;/sub&gt; は Follower が出した関節 j の指令。&lt;span style=&quot;color:#b85450&quot;&gt;±1 で切る&lt;b&gt;前&lt;/b&gt;の値&lt;/span&gt;に掛かる（トルクの側は切ってからギア比を掛ける）。&lt;br&gt;分母の 5 には箱の 2 つのスライドの自由度（指令はいつも 0）が入るので、1 関節あたりの重みは 0.2 ／ 5 ＝ &lt;b&gt;0.04&lt;/b&gt;（修論 4.1.2）" vertex="1">
          <mxGeometry height="190" width="280" x="335" y="555" as="geometry" />
        </mxCell>
        <mxCell id="p6_L4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;足していない項&lt;/b&gt;（起動行で 0 にしてある。queue_phys.sh の PUSH）&lt;br&gt;・腕の先を箱へ近づける項（contact_weight ＝ 0）・生き残りのボーナス（0）・目標の位置の項（押しには無い）&lt;br&gt;項を足すと、報酬が特定の腕に合わせた調整になるか、箱を動かさない方策に落ちて、形の評価が働かなくなる（修論 4.1.2）" vertex="1">
          <mxGeometry height="95" width="590" x="35" y="770" as="geometry" />
        </mxCell>
        <mxCell id="p6_L5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;1 話の合計 ＝ exec_R_eps&lt;/b&gt;（log_train.txt に出る成績）&lt;br&gt;R ＝ Σ r&lt;sub&gt;t&lt;/sub&gt;。押しの項を足し合わせると (x&lt;sub&gt;終わり&lt;/sub&gt; − x&lt;sub&gt;始め&lt;/sub&gt;) ／ Δt になるので、&lt;b&gt;箱を x へ 1 m 進めると約 +25&lt;/b&gt;（横ずれと制御コストの分だけ減る）。&lt;br&gt;制御コストは、3 関節とも |u| ＝ 1 なら 1 step で 0.04 × 3 ＝ 0.12" vertex="1">
          <mxGeometry height="100" width="590" x="35" y="880" as="geometry" />
        </mxCell>
        <mxCell id="p6_L6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;Leader の報酬&lt;/b&gt;（修論 3.1・3.4）&lt;br&gt;J&lt;sup&gt;L&lt;/sup&gt; ＝ E[ Σ&lt;sub&gt;形の段&lt;/sub&gt; γ&lt;sup&gt;t&lt;/sup&gt; R&lt;sup&gt;L&lt;/sup&gt; ＋ Σ&lt;sub&gt;実行の段&lt;/sub&gt; γ&lt;sup&gt;t−T&lt;/sup&gt; R&lt;sup&gt;F&lt;/sup&gt; ]。本研究は R&lt;sup&gt;L&lt;/sup&gt; ＝ 0 なので、形は&lt;b&gt;その形で Follower が稼いだリターン（第 2 項）だけ&lt;/b&gt;で評価される。実装は Leader のリターンを割引なしの和で計算する。門に当たった形は −50 なので、Leader はその形を避けるよう学習する" vertex="1">
          <mxGeometry height="115" width="590" x="35" y="995" as="geometry" />
        </mxCell>
        <mxCell id="p6_R" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#9673a6;" value="&lt;b&gt;ネットワーク&lt;/b&gt;　方策（Leader・Follower）と価値関数" vertex="1">
          <mxGeometry height="1050" width="620" x="660" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p6_R1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=12;" value="&lt;b&gt;観測: 体（ノード）ごとに 1 行。Follower の 1 行は 24 変数&lt;/b&gt;" vertex="1">
          <mxGeometry height="273" width="590" x="675" y="105" as="geometry" />
        </mxCell>
        <mxCell id="p6_h0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;深さ 4&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="85" x="790" y="135" as="geometry" />
        </mxCell>
        <mxCell id="p6_h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;シミュレーションの状態 17&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="225" x="880" y="135" as="geometry" />
        </mxCell>
        <mxCell id="p6_h2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;形の値 3&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="145" x="1110" y="135" as="geometry" />
        </mxCell>
        <mxCell id="p6_n0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="0 台座" vertex="1">
          <mxGeometry height="38" width="95" x="685" y="168" as="geometry" />
        </mxCell>
        <mxCell id="p6_d0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" value="深さ 0&lt;br&gt;（one-hot）" vertex="1">
          <mxGeometry height="38" width="85" x="790" y="168" as="geometry" />
        </mxCell>
        <mxCell id="p6_s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="&lt;b&gt;箱 − 腕の先&lt;/b&gt;（x, y, z の 3 つ）&lt;br&gt;残り 14 は 0" vertex="1">
          <mxGeometry height="38" width="225" x="880" y="168" as="geometry" />
        </mxCell>
        <mxCell id="p6_g0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="太さ・後方延長・&lt;br&gt;ギア比（正規化）" vertex="1">
