        <mxCell id="tk3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;tick 4&lt;/b&gt;　0.01 s">
