          <mxGeometry x="40" y="115" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tk0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;tick 1&lt;/b&gt;　0.01 s">
