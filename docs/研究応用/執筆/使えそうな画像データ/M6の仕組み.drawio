        <mxCell id="gtime" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="時間の刻み：方策は 1 step に 1 回だけ決め、物理はその間に 4 回進む">
