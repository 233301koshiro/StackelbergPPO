        <mxCell id="p6_R1t" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="0がいっぱいあるのは先行研究のせいだし計算が多少無駄になるだけで影響もない&lt;br&gt;&lt;b&gt;Leader の 1 行は 深さ 4 ＋ 形の値 3 ＝ 7&lt;/b&gt;（シミュレーションの状態は見ない）" vertex="1">
          <mxGeometry height="26" width="410" x="685" y="347" as="geometry" />
        </mxCell>
        <mxCell id="p6_R2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=12;" value="&lt;b&gt;Follower の方策（実行の段）　1 step に 1 回、4 行をまとめて通す&lt;/b&gt;" vertex="1">
          <mxGeometry height="375" width="590" x="675" y="390" as="geometry" />
        </mxCell>
        <mxCell id="p6_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#666666;" value="観測 4 行 × 24" vertex="1">
          <mxGeometry height="40" width="255" x="690" y="425" as="geometry" />
        </mxCell>
        <mxCell id="p6_b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" value="線形 24 → 64&lt;br&gt;＋ 体の番号の埋め込み（64）" vertex="1">
          <mxGeometry height="55" width="255" x="690" y="485" as="geometry" />
        </mxCell>
        <mxCell id="p6_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Transformer のブロック × 3&lt;/b&gt;&lt;br&gt;自己注意 → MLP 64 → 256 → 64&lt;br&gt;（どの行も他の全行を見る）" vertex="1">
          <mxGeometry height="75" width="255" x="690" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p6_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" value="行ごとに線形 64 → 1 ＝ 指令の平均 μ&lt;sub&gt;j&lt;/sub&gt;" vertex="1">
          <mxGeometry height="40" width="255" x="690" y="655" as="geometry" />
        </mxCell>
        <mxCell id="p6_f" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="u&lt;sub&gt;j&lt;/sub&gt; ～ 正規分布 N(μ&lt;sub&gt;j&lt;/sub&gt;, σ&lt;sup&gt;2&lt;/sup&gt;) → env へ&lt;br&gt;&lt;b&gt;※ここから2pageの&lt;br&gt;「env ④ 実行の段 1 step」を見よう&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="255" x="690" y="715" as="geometry" />
        </mxCell>
        <mxCell id="p6_ae" edge="1" parent="1" source="p6_a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_b" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6_be" edge="1" parent="1" source="p6_b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" target="p6_c" value="">
          <mxGeometry relative="1" as="geometry" />
