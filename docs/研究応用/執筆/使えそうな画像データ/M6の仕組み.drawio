        <mxCell id="p6_t1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="形の段 6 step&lt;br&gt;&lt;span style=&quot;color:#b85450&quot;&gt;&lt;b&gt;r = 0&lt;/b&gt;&lt;/span&gt;" vertex="1">
