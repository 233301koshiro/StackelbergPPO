        <mxCell id="lg3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=13;arcSize=6;fontSize=11;" value="近似・単純化">
          <mxGeometry x="994" y="18" width="100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;fontSize=11;" value="掛け方を直した">
          <mxGeometry x="1102" y="18" width="110" height="26" as="geometry" />
        </mxCell>
        <mxCell id="gparts" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="モデルの部品と、付いている値">
          <mxGeometry x="20" y="70" width="370" height="620" as="geometry" />
        </mxCell>
        <mxCell id="p0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;台座の柱（縦型）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#fafafa;border:1px solid #b3b3b3;padding:0 3px&quot;&gt;向き・長さ・太さは描いたまま固定&lt;/span&gt;&lt;br&gt;（倒れて床を這う腕になった。Bug 58）">
          <mxGeometry x="35" y="110" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;リンク（棒）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;長さ&lt;/span&gt; &lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;太さ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;密度 → 質量&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#fafafa;border:1px solid #b3b3b3;padding:0 3px&quot;&gt;形はカプセル&lt;/span&gt; &lt;span style=&quot;background:#fafafa;border:1px solid #b3b3b3;padding:0 3px&quot;&gt;質量は中実の式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#fafafa;border:1px solid #b3b3b3;padding:0 3px&quot;&gt;隣り合うリンクどうしは当たらない&lt;/span&gt;">
          <mxGeometry x="35" y="200" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;関節（回転のヒンジ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;位置・つながり（スケッチから）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;軸（利用者が与える）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;可動域&lt;/span&gt; &lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;減衰 b&lt;/span&gt;">
          <mxGeometry x="35" y="365" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;モーター（アクチュエータ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;ギア比 ＝ 最大トルク（探索する）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;最大トルクの上限 150 N·m&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;速さの上限 3.14 rad/s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;回転子の慣性 1.71 kg·m²&lt;/span&gt;">
          <mxGeometry x="35" y="500" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f3f8fe;" value="形から来る値">
          <mxGeometry x="410" y="70" width="425" height="300" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;スケッチ → M3〜M5 が決め、長さ・太さ・ギア比は Leader が探索する&lt;/b&gt;&lt;br&gt;&lt;br&gt;・関節の位置・リンクのつながり（スケッチのまま固定）&lt;br&gt;・関節の軸（平面モード・縦型モード。&lt;b&gt;形から推定はしない&lt;/b&gt;）&lt;br&gt;・リンクの長さ: 設計長の 0.5〜2.93 倍の範囲（縦型）&lt;br&gt;・太さ&lt;br&gt;・ギア比（＝ 関節の最大トルク）: 縦型 25〜150・平面 20〜150 N·m の範囲">
          <mxGeometry x="425" y="105" width="395" height="250" as="geometry" />
        </mxCell>
        <mxCell id="g2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#eef7ec;" value="実在の部品から導いた値（*_phys、系譜 9-246）">
          <mxGeometry x="855" y="70" width="425" height="300" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;UR5e（産業用アーム）とアルミパイプから&lt;/b&gt;&lt;br&gt;&lt;br&gt;・リンクの密度 189.9〜294.2 kg/m³（A6061・肉厚 2 mm のパイプの実効密度。形ごと）&lt;br&gt;・最大トルクの上限 150 N·m（UR5e の関節トルク）&lt;br&gt;・回転子の慣性 1.71 kg·m²（UR5e のモーター＋減速機 × 減速比 100²）&lt;br&gt;・速さの上限 3.14 rad/s（UR5e の最大速度 180°/s）&lt;br&gt;・長さの探索幅の上限 2.93 倍（UR5e の 150 N·m で自重を支えられる最大の伸び。e2e_a1v で導き、縦型すべてに流用）">
          <mxGeometry x="870" y="105" width="395" height="250" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fff5e8;" value="根拠の無いまま宣言して使う値">
          <mxGeometry x="410" y="390" width="425" height="300" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;修論では「宣言して使う」と書く（想定問答 Q15）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・関節の減衰 b ＝ 1 N·m·s/rad（原論文のまま）&lt;br&gt;・可動域: 平面 ±180°・縦型 ±90°（第1層の判定に効かないことは確かめた）&lt;br&gt;・制御コストの係数 0.2（報酬の項。層 D）&lt;br&gt;・接触の摩擦 0.5（Choreonoid の既定。変換器が XML の摩擦を読まない）&lt;br&gt;・時間の刻み 0.01 s、1 話 1000 step（原論文のまま）">
          <mxGeometry x="425" y="425" width="395" height="250" as="geometry" />
        </mxCell>
        <mxCell id="g4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f5f5f5;" value="近似・単純化（全条件で同じ）">
          <mxGeometry x="855" y="390" width="425" height="300" as="geometry" />
        </mxCell>
        <mxCell id="v4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;全条件が同じ近似を共有するので、順序の比較は成り立つ（Q33）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・リンクはカプセル、質量は中実の式（太さを変えると、同じ太さの実在のパイプの 0.55〜2.75 倍）&lt;br&gt;・隣り合うリンクは当たらない（120° を超えて折り返せる。Q18）&lt;br&gt;・台座の柱は描いたまま&lt;br&gt;・跳ね返りはほぼ 0（実効の反発係数 約 0.055。AIST が扱えない）">
          <mxGeometry x="870" y="425" width="395" height="250" as="geometry" />
        </mxCell>
        <mxCell id="gfix" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fffbea;" value="値の掛け方を直したもの（値は同じでも、移植で掛け方が誤っていた。全部直して取り直した）">
          <mxGeometry x="20" y="715" width="1260" height="135" as="geometry" />
        </mxCell>
        <mxCell id="x1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;制御入力を ±1 で切る&lt;/b&gt;&lt;br&gt;切っておらず、トルクが上限の最大 2.7 倍出ていた（Bug 60）">
          <mxGeometry x="35" y="750" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="x2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;減衰をトルク −b·q̇ で掛ける&lt;/b&gt;&lt;br&gt;箱用の式の流用で、強さが腕の重さで 0.24〜30 倍変わっていた（Bug 61）">
          <mxGeometry x="345" y="750" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="x3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;速さの上限で位置も進め直す&lt;/b&gt;&lt;br&gt;実効の最高速度が 6〜57 % 上回り、ギア比と太さで変わっていた（Bug 65）">
          <mxGeometry x="655" y="750" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="x4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;箱・パックの回転子の慣性を 0 に&lt;/b&gt;&lt;br&gt;既定値が対象にも掛かり、パックが実効 34 倍重かった（Bug 62）">
          <mxGeometry x="965" y="750" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　実在の部品から導いた値と、根拠なく決めた値を 2 つずつ&lt;/b&gt;&lt;br&gt;実在: 回転子の慣性 1.71 kg·m²（UR5e）、最大トルクの上限 150 N·m（UR5e）、ほかに密度・速さの上限。&lt;br&gt;根拠なし: 減衰 b ＝ 1、可動域、ほかに制御コスト・摩擦">
          <mxGeometry x="20" y="880" width="410" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　物理を少し変えると判定は変わるか（Q38）&lt;/b&gt;&lt;br&gt;敏感な形はある（tick の完了を待たずに再生すると、長腕 seed 1 の誤差 1.35 → 27.59 mm、中腕は変わらない）。比べる条件はすべて同じ物理で学習・評価するので順位は比べられる。箱の質量・滑りを 0.5〜2 倍にしても押しの順位は保たれた（Q39）">
          <mxGeometry x="445" y="880" width="410" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;言わないこと&lt;/b&gt;&lt;br&gt;・形の差を「慣性」で説明しない: 根元の関節の慣性のうち、リンクの形の寄与は 1.8〜40 %（大部分は回転子。系譜 9-253）。幾何で説明できないかを先に見る&lt;br&gt;・絶対的な性能（何 m 押せるか）は主張しない">
          <mxGeometry x="870" y="880" width="410" height="135" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
