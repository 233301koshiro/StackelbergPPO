        <mxCell id="v7ojy4U_bRa76cNFjyFZ-1" parent="5Ejabf1Gpna0H29OLXS6-10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;関節ごとの特徴 h&lt;/b&gt;&lt;br&gt;Transformer の出力&lt;br&gt;（関節 1 つにつき 64 個の数）。" vertex="1">
          <mxGeometry height="58.78787878787879" width="250" x="20.220000000000027" y="48.98989898989899" as="geometry" />
        </mxCell>
        <mxCell id="v7ojy4U_bRa76cNFjyFZ-3" parent="5Ejabf1Gpna0H29OLXS6-10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;指令の平均 μ&lt;/b&gt;（関節ごとに 1 つ）&lt;br&gt;上の式で出す。単位は無く、まだトルクではない" vertex="1">
          <mxGeometry height="58.78787878787879" width="250" x="20.220000000000027" y="156.76767676767676" as="geometry" />
        </mxCell>
        <mxCell id="v7ojy4U_bRa76cNFjyFZ-5" parent="5Ejabf1Gpna0H29OLXS6-10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ゆらぎの幅 σ&lt;/b&gt;&lt;br&gt;全関節で共通の 1 つの値。&lt;br&gt;状態によらず、学習で直る&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="83.28282828282828" width="240" x="286.22" y="151.86868686868686" as="geometry" />
        </mxCell>
        <mxCell id="v7ojy4U_bRa76cNFjyFZ-6" parent="5Ejabf1Gpna0H29OLXS6-10" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="68.58585858585859" width="124.97323232323232" x="286.22" y="300.7979797979798" as="geometry" />
        </mxCell>
        <mxCell id="5Ejabf1Gpna0H29OLXS6-2" parent="5Ejabf1Gpna0H29OLXS6-10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacing=2;" value="μ を中心・σ を幅とする山から u を 1 つ引く。&lt;br&gt;測るとき（③ 測る）は ε ＝ 0 で u ＝ μ" vertex="1">
          <mxGeometry height="97.97979797979798" width="110" x="416.22" y="299.8181818181818" as="geometry" />
        </mxCell>
        <mxCell id="5Ejabf1Gpna0H29OLXS6-3" parent="5Ejabf1Gpna0H29OLXS6-10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;指令 u ＝ μ ＋ σ・ε&lt;/b&gt;&lt;br&gt;ε は平均 0・幅 1 の正規分布の乱数。&lt;br&gt;関節ごと・step ごとに引き直す" vertex="1">
          <mxGeometry height="68.58585858585859" width="250" x="20.220000000000027" y="269.44444444444446" as="geometry" />
        </mxCell>
        <mxCell id="5Ejabf1Gpna0H29OLXS6-5" parent="5Ejabf1Gpna0H29OLXS6-10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;トルク ＝ u × ギア比&lt;/b&gt; [N·m]&lt;br&gt;u は先に ±1 で切る。ギア比は Leader が決めた設計変数（水平アーム 20〜150）なので、&lt;b&gt;最大トルク ＝ ギア比&lt;/b&gt;" vertex="1">
          <mxGeometry height="83.28282828282828" width="250" x="20.220000000000027" y="391.9191919191919" as="geometry" />
        </mxCell>
        <mxCell id="f_note_mu" parent="5Ejabf1Gpna0H29OLXS6-10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacing=2;" value="w（64 個）と b は&lt;b&gt;全関節で共通&lt;/b&gt;。関節ごとに h が違うので、μ も関節ごとに違う" vertex="1">
          <mxGeometry height="39.19191919191919" width="240" x="286.22" y="89.16161616161617" as="geometry" />
        </mxCell>
        <mxCell id="f_note_tq" parent="5Ejabf1Gpna0H29OLXS6-10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;spacing=2;" value="・±1 で切るのは環境の側。&lt;br&gt;制御コストは切る前の u で計算する&lt;br&gt;・u もトルクも関節の数だけ並んだリスト&lt;br&gt;（台座の分の出力は捨てる）" vertex="1">
          <mxGeometry height="83.28282828282828" width="240" x="286.22" y="391.9191919191919" as="geometry" />
        </mxCell>
