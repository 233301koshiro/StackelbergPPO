        <mxCell id="f_body" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;Choreonoid の .body&lt;/b&gt;&lt;br&gt;学習・再生の本番（USE_CHOREONOID=1）">
          <mxGeometry x="890" y="645" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_mj" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=11;" value="&lt;b&gt;MuJoCo そのもの&lt;/b&gt;&lt;br&gt;解析やプローブで使うことがある。&lt;br&gt;&lt;span style=&quot;color:#b85450&quot;&gt;物理が違う&lt;/span&gt;（壁が有る・接触の値が効く）。&lt;br&gt;プローブを信じる前に、どちらで回っているかを確かめる（分かれ目は USE_CHOREONOID=1。ホッケーの壁の 8 回の空振り、系譜 9-98）">
          <mxGeometry x="890" y="740" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fe1" parent="1" edge="1" source="f_xml" target="f_conv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="">
