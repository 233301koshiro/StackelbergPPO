        <mxCell id="lg2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;fontSize=11;" value="根拠の無いまま宣言して使う値">
          <mxGeometry x="796" y="18" width="190" height="26" as="geometry" />
