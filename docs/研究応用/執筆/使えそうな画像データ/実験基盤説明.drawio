<mxfile host="drawio" type="device"><diagram id="easy" name="やさしい版"><mxGraphModel dx="2200" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="実験の土台：画面のどこが何か（やさしい版）" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20.0" y="20.0" width="1400.0" height="40.0" as="geometry"/></mxCell><mxCell id="st" value="Choreonoid の画面（再生用のスクリプト eval_cnoid_viewer.py で学習済みの方策を動かしたところ）に、4 つの部品の名前を当てた。色は部品ごと。" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20.0" y="62.0" width="820.0" height="60.0" as="geometry"/></mxCell><mxCell id="img" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#999999;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="380.0" y="230.0" width="1400.0" height="787.5" as="geometry"/></mxCell><mxCell id="h1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1046.5" y="231.5" width="67.0" height="19.4" as="geometry"/></mxCell><mxCell id="h2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="656.6" y="322.5" width="785.9" height="506.6" as="geometry"/></mxCell><mxCell id="h3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e65100;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="406.0" y="341.4" width="61.4" height="13.8" as="geometry"/></mxCell><mxCell id="h4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e65100;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="378.0" y="704.7" width="277.0" height="13.8" as="geometry"/></mxCell><mxCell id="h5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6a1b9a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="406.0" y="350.5" width="114.6" height="23.6" as="geometry"/></mxCell><mxCell id="h6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6a1b9a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="656.6" y="907.0" width="147.5" height="30.6" as="geometry"/></mxCell><mxCell id="h7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2e7d32;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="656.6" y="965.8" width="345.6" height="31.3" as="geometry"/></mxCell><mxCell id="h8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2e7d32;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="702.8" y="830.0" width="75.4" height="18.0" as="geometry"/></mxCell><mxCell id="c_cn" value="&lt;b style=&quot;font-size:17px&quot;&gt;Choreonoid&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;ロボットを動かすシミュレータ。&lt;br&gt;このウィンドウ全体がそれ。真ん中の Scene に動く様子が映る&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="880.0" y="128.0" width="440.0" height="92.0" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=classic;html=1;strokeColor=#1565c0;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_cn"><mxGeometry relative="1" as="geometry"><mxPoint x="1080.0" y="248.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b10" value="Choreonoid が描いたロボットと箱" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666.6" y="332.5" width="240.0" height="20.0" as="geometry"/></mxCell><mxCell id="c_ph" value="&lt;b style=&quot;font-size:17px&quot;&gt;物理エンジン&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;接触や力を計算する計算機。&lt;br&gt;左上の「AISTSimulator」がそれ。当たり判定は下の「AISTCollisionDetector」が受け持つ&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="240.0" width="330.0" height="150.0" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=classic;html=1;strokeColor=#e65100;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_ph"><mxGeometry relative="1" as="geometry"><mxPoint x="408.0" y="348.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b12" value="↑ Collision detector の行：当たり判定も物理エンジンの仕事" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e65100;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="384.0" y="776.5" width="262.0" height="36.0" as="geometry"/></mxCell><mxCell id="c_xml" value="&lt;b style=&quot;font-size:17px&quot;&gt;XML / .body&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;ロボットや箱の設計図。&lt;br&gt;左上のアームと cube はこの設計図から作られた。形が変わるたびに新しい .body を読み直す（下の Loading Body の行）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="430.0" width="330.0" height="170.0" as="geometry"/></mxCell><mxCell id="e13" style="endArrow=classic;html=1;strokeColor=#6a1b9a;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_xml"><mxGeometry relative="1" as="geometry"><mxPoint x="408.0" y="362.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b14" value="← 形が変わるたびに .body を読み直す" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#6a1b9a;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810.1" y="915.0" width="260.0" height="20.0" as="geometry"/></mxCell><mxCell id="c_env" value="&lt;b style=&quot;font-size:17px&quot;&gt;env&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Python で書かれた操縦係。&lt;br&gt;画面には出てこない。[デモ] の行は env を動かしている Python が書いたもの。打ち込み口は Python Console&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="700.0" y="1050.0" width="560.0" height="110.0" as="geometry"/></mxCell><mxCell id="e15" style="endArrow=classic;html=1;strokeColor=#2e7d32;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_env"><mxGeometry relative="1" as="geometry"><mxPoint x="829.4" y="995.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b16" value="← Python の打ち込み口" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#2e7d32;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="784.2" y="830.0" width="170.0" height="18.0" as="geometry"/></mxCell><mxCell id="rh" value="4 つのつながり（1 step）" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1820.0" y="230.0" width="380.0" height="30.0" as="geometry"/></mxCell><mxCell id="f_env" value="&lt;b&gt;env&lt;/b&gt;&lt;br&gt;Python の操縦係" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="270.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="f_cn" value="&lt;b&gt;Choreonoid&lt;/b&gt;&lt;br&gt;シミュレータ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="420.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="f_ph" value="&lt;b&gt;物理エンジン&lt;/b&gt;&lt;br&gt;AIST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="570.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="f_xml" value="&lt;b&gt;XML / .body&lt;/b&gt;&lt;br&gt;設計図" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="720.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="l17" value="トルクを渡す" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="f_env" target="f_cn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l18" value="位置・速さ" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="f_cn" target="f_env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l19" value="4 回進めて" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="f_cn" target="f_ph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l20" value="接触と力の結果" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="f_ph" target="f_cn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l21" value="読み込む" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="f_xml" target="f_cn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;学習中は画面が無い&lt;/b&gt;&lt;br&gt;この画面は再生用。学習のときは同じしくみが画面なし（--no-window）で 5 つ同時に動いている（本体 1・ワーカー 4）。詳しくは M6の仕組み.drawio の 3 ページ目（層 E）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1820.0" y="830.0" width="380.0" height="120.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="acad" name="学術版"><mxGraphModel dx="2200" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="実験基盤の構成要素と GUI 上の対応" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20.0" y="20.0" width="1400.0" height="40.0" as="geometry"/></mxCell><mxCell id="st" value="Choreonoid の GUI（学習済み方策の再生スクリプト eval_cnoid_viewer.py の実行時）に、実験基盤を構成する 4 要素を対応づけた。" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20.0" y="62.0" width="820.0" height="60.0" as="geometry"/></mxCell><mxCell id="img" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;strokeColor=#999999;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="380.0" y="230.0" width="1400.0" height="787.5" as="geometry"/></mxCell><mxCell id="h1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1046.5" y="231.5" width="67.0" height="19.4" as="geometry"/></mxCell><mxCell id="h2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="656.6" y="322.5" width="785.9" height="506.6" as="geometry"/></mxCell><mxCell id="h3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e65100;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="406.0" y="341.4" width="61.4" height="13.8" as="geometry"/></mxCell><mxCell id="h4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e65100;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="378.0" y="704.7" width="277.0" height="13.8" as="geometry"/></mxCell><mxCell id="h5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6a1b9a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="406.0" y="350.5" width="114.6" height="23.6" as="geometry"/></mxCell><mxCell id="h6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6a1b9a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="656.6" y="907.0" width="147.5" height="30.6" as="geometry"/></mxCell><mxCell id="h7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2e7d32;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="656.6" y="965.8" width="345.6" height="31.3" as="geometry"/></mxCell><mxCell id="h8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2e7d32;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="702.8" y="830.0" width="75.4" height="18.0" as="geometry"/></mxCell><mxCell id="c_cn" value="&lt;b style=&quot;font-size:17px&quot;&gt;Choreonoid&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;産業技術総合研究所が開発したロボット用統合シミュレーションソフトウェア。モデルの読み込み、時間発展の管理および描画を担う&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="880.0" y="128.0" width="440.0" height="92.0" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=classic;html=1;strokeColor=#1565c0;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_cn"><mxGeometry relative="1" as="geometry"><mxPoint x="1080.0" y="248.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b10" value="Choreonoid による描画" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666.6" y="332.5" width="170.0" height="20.0" as="geometry"/></mxCell><mxCell id="c_ph" value="&lt;b style=&quot;font-size:17px&quot;&gt;物理エンジン（AIST シミュレータ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Choreonoid 標準の動力学計算部。各時間刻みにおいて衝突検出（AISTCollisionDetector）、接触拘束力の算出、運動方程式の数値積分を行う&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="240.0" width="330.0" height="150.0" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=classic;html=1;strokeColor=#e65100;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_ph"><mxGeometry relative="1" as="geometry"><mxPoint x="408.0" y="348.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b12" value="↑ Collision detector の行：衝突検出器（物理エンジンの一部）" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e65100;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="384.0" y="776.5" width="262.0" height="36.0" as="geometry"/></mxCell><mxCell id="c_xml" value="&lt;b style=&quot;font-size:17px&quot;&gt;モデル記述（XML / .body）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;ロボットおよび操作対象の形状・質量・関節を定義する記述。形態は MuJoCo 互換 XML で表し、変換器が Choreonoid の .body 形式へ変換して読み込む。形態の更新ごとに再生成される&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="430.0" width="330.0" height="185.0" as="geometry"/></mxCell><mxCell id="e13" style="endArrow=classic;html=1;strokeColor=#6a1b9a;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_xml"><mxGeometry relative="1" as="geometry"><mxPoint x="408.0" y="362.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b14" value="← 形態更新ごとの .body の再読み込み" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#6a1b9a;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810.1" y="915.0" width="270.0" height="20.0" as="geometry"/></mxCell><mxCell id="c_env" value="&lt;b style=&quot;font-size:17px&quot;&gt;環境（env）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;強化学習の環境を実装した Python クラス（Gymnasium 形式の step）。方策の行動を関節トルク指令に変換してシミュレータへ与え、制御周期 0.04 s ごとに観測・報酬・終了判定を返す。GUI 上には直接現れず、[デモ] の出力は env を呼び出すスクリプトによる&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="700.0" y="1050.0" width="560.0" height="130.0" as="geometry"/></mxCell><mxCell id="e15" style="endArrow=classic;html=1;strokeColor=#2e7d32;strokeWidth=2.5;endFill=1;" edge="1" parent="1" source="c_env"><mxGeometry relative="1" as="geometry"><mxPoint x="829.4" y="995.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b16" value="← Python コンソール" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#2e7d32;fontColor=#ffffff;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="784.2" y="830.0" width="150.0" height="18.0" as="geometry"/></mxCell><mxCell id="rh" value="構成要素間のデータの流れ（1 制御周期）" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1820.0" y="230.0" width="380.0" height="30.0" as="geometry"/></mxCell><mxCell id="f_env" value="&lt;b&gt;環境（env）&lt;/b&gt;&lt;br&gt;Python" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="270.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="f_cn" value="&lt;b&gt;Choreonoid&lt;/b&gt;&lt;br&gt;シミュレーション基盤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="420.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="f_ph" value="&lt;b&gt;物理エンジン&lt;/b&gt;&lt;br&gt;AIST シミュレータ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="570.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="f_xml" value="&lt;b&gt;モデル記述&lt;/b&gt;&lt;br&gt;XML → .body" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860.0" y="720.0" width="260.0" height="80.0" as="geometry"/></mxCell><mxCell id="l17" value="関節トルク指令" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="f_env" target="f_cn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l18" value="関節角度・角速度" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="f_cn" target="f_env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l19" value="時間刻みの進行" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="f_cn" target="f_ph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l20" value="接触力・状態の更新" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="f_ph" target="f_cn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l21" value="読み込み" style="html=1;endArrow=classic;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="f_xml" target="f_cn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;学習時の構成&lt;/b&gt;&lt;br&gt;本図は可視化のための再生時の画面である。学習時は同一の構成が描画なし（--no-window）で動作し、主プロセス 1 とサンプリング用ワーカー 4 の計 5 プロセスが並列に実行される（M6の仕組み.drawio、層 E）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1820.0" y="830.0" width="380.0" height="140.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>