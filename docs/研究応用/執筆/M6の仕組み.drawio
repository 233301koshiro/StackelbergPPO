        <mxCell id="ep" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;align=left;" value="↑ ここまでで &lt;b&gt;1 話（エピソード）&lt;/b&gt;。&lt;br&gt;話ごとに形を決め直し、5 万 step たまるまでくり返す。&lt;br&gt;毎話、初期位置に ±0.1 のずれが入る（くじ）。&lt;br&gt;形が初めから床や箱に当たっていたら、動かさずに罰で終える"><mxGeometry x="340" y="295" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="g2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f5f0f8;" value="② 直す（ネットワークの更新）"><mxGeometry x="320" y="420" width="310" height="200" as="geometry"/></mxCell>
        <mxCell id="u_f" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;" value="&lt;b&gt;Follower&lt;/b&gt; ← ふつうの PPO"><mxGeometry x="335" y="460" width="280" height="40" as="geometry"/></mxCell>
        <mxCell id="u_l" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;" value="&lt;b&gt;Leader&lt;/b&gt; ← Stackelberg 勾配&lt;br&gt;「形を変えたら Follower がどう&lt;br&gt;合わせるか」を見越して直す"><mxGeometry x="335" y="510" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="u_v" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;価値関数&lt;/b&gt; ← 実際のリターンに合わせる"><mxGeometry x="335" y="580" width="280" height="30" as="geometry"/></mxCell>
