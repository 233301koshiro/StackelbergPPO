        <mxCell id="f_conv" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value='&lt;b&gt;変換器 mujoco_xml_to_body&lt;/b&gt;&lt;br&gt;&lt;span style="color:#b85450"&gt;&lt;b&gt;⚠️ 読まないもの（書いても物理に無い）&lt;/b&gt;&lt;/span&gt;&lt;br&gt;・worldbody 直下の geom（壁・障害物）&lt;br&gt;・接触の値（solref・solimp・摩擦）&lt;br&gt;・cylinder（扱えるのは capsule・sphere・box）'><mxGeometry x="890" y="490" width="370" height="125" as="geometry"/></mxCell>
        <mxCell id="f_body" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;Choreonoid の .body&lt;/b&gt;&lt;br&gt;学習・再生の本番（USE_CHOREONOID=1）"><mxGeometry x="890" y="645" width="370" height="60" as="geometry"/></mxCell>
        <mxCell id="f_mj" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=11;" value='&lt;b&gt;MuJoCo そのもの&lt;/b&gt;&lt;br&gt;解析やプローブで使うことがある。&lt;br&gt;&lt;span style="color:#b85450"&gt;物理が違う&lt;/span&gt;（壁が有る・接触の値が効く）。&lt;br&gt;プローブを信じる前に、どちらで回っているかを確かめる（分かれ目は USE_CHOREONOID=1。ホッケーの壁の 8 回の空振り、系譜 9-98）'><mxGeometry x="890" y="740" width="370" height="140" as="geometry"/></mxCell>
        <mxCell id="fe1" parent="1" edge="1" source="f_xml" target="f_conv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe2" parent="1" edge="1" source="f_conv" target="f_body" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe3" parent="1" edge="1" source="f_xml" target="f_mj" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="そのまま"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="430"/><mxPoint x="1270" y="810"/></Array></mxGeometry></mxCell>
        <mxCell id="gcap" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="物理エンジンにできること・できないこと"><mxGeometry x="20" y="930" width="1260" height="200" as="geometry"/></mxCell>
        <mxCell id="c_ok" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;AIST にできる&lt;/b&gt;&lt;br&gt;・当たり判定&lt;br&gt;・接触の力（反復で解く）&lt;br&gt;・摩擦（材質ごと）&lt;br&gt;・運動の積分（この 3 つの中身は層 F）"><mxGeometry x="35" y="970" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="c_ng" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;AIST にできない → env が足す&lt;/b&gt;&lt;br&gt;・跳ね返り: 設定の口（setEpsilon）はあるが、値が計算に使われない。実測の反発係数は約 0.055&lt;br&gt;・関節の減衰・可動域を守ること&lt;br&gt;→ env が毎 tick 手で足す（2 ページ目の橙）"><mxGeometry x="450" y="970" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="c_bl" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;Bullet に替えれば？ → 替えない&lt;/b&gt;&lt;br&gt;・跳ね返りは扱えるが、この環境では開始時に Segmentation fault（11-16、Bug 103）&lt;br&gt;・動いても、env が書く関節の位置・速度が届かない&lt;br&gt;・接触がすべて変わり、これまでの結果と比べられなくなる"><mxGeometry x="865" y="970" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　「Choreonoid で学習した」とき、物理を計算しているのは誰か&lt;/b&gt;&lt;br&gt;AIST（Choreonoid の中の部品）。Choreonoid はモデルの読み込みと時間の管理をする入れ物。ただし減衰・速さの上限・可動域・跳ね返りは env が足している"><mxGeometry x="20" y="1160" width="410" height="125" as="geometry"/></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　エンジンを替えると、何が変わり何が変わらないか&lt;/b&gt;&lt;br&gt;変わる: 接触のすべて（当たり方・力・跳ね返り）、env が書く値が届くか。変わらない: Choreonoid・env の報酬・方策・XML。接触が変わるので、これまでの結果と比べられなくなる"><mxGeometry x="445" y="1160" width="410" height="125" as="geometry"/></mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;なぜ Choreonoid か（想定問答 Q60）&lt;/b&gt;&lt;br&gt;研究室のシミュレータだから（RobotAssembler もこの上）。律速は物理ではなく更新（上の段の秒数）。&lt;br&gt;❌「精度が高いから選んだ」「GPU 版にすれば速い」とは言わない"><mxGeometry x="870" y="1160" width="410" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
