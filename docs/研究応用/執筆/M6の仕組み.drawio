        <mxCell id="lg3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;fontSize=11;" value="env が物理エンジンの外で足すもの"><mxGeometry x="784" y="18" width="210" height="26" as="geometry"/></mxCell>
        <mxCell id="lg4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=13;arcSize=6;fontSize=11;" value="シミュレータ（層 E・F）"><mxGeometry x="1002" y="18" width="160" height="26" as="geometry"/></mxCell>
        <mxCell id="gpol" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f7f2fa;" value="方策（層 B・C）"><mxGeometry x="20" y="70" width="230" height="760" as="geometry"/></mxCell>
        <mxCell id="leader" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;" value="&lt;b&gt;Leader&lt;/b&gt;&lt;br&gt;形を編集する量を出す&lt;br&gt;（形の段だけ動く）"><mxGeometry x="35" y="240" width="200" height="105" as="geometry"/></mxCell>
        <mxCell id="follower" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;" value="&lt;b&gt;Follower&lt;/b&gt;&lt;br&gt;関節ごとの指令を出す&lt;br&gt;（実行の段だけ動く）&lt;br&gt;形の値も観測に入る"><mxGeometry x="35" y="525" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="pol_note" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontSize=11;" value="どちらもニューラルネット&lt;br&gt;（形を木として扱う Transformer）。&lt;br&gt;env から見ると&lt;br&gt;「観測を渡すと行動が返る箱」"><mxGeometry x="30" y="110" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="genv" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="env（PusherEnv ＋ ChoreonoidEnv）　1 話は上から下へ進む"><mxGeometry x="290" y="70" width="580" height="760" as="geometry"/></mxCell>
        <mxCell id="s0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;" value="&lt;b&gt;⓪ reset&lt;/b&gt;　形と姿勢を初期値に戻す"><mxGeometry x="310" y="110" width="540" height="45" as="geometry"/></mxCell>
        <mxCell id="s1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;① 形の段 1 step 目&lt;/b&gt;　骨格を変える段 → 素通り&lt;br&gt;（リンクのつながりはスケッチのまま固定。fix_skeleton）"><mxGeometry x="310" y="170" width="540" height="55" as="geometry"/></mxCell>
        <mxCell id="s2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value='&lt;b&gt;② 形の段 2〜6 step 目（5 回）&lt;/b&gt;&lt;br&gt;Leader の行動 → 設計の値（−1〜1 に切る）&lt;br&gt;→ リンクの長さ・太さ・ギア比に直す → XML を書き出す&lt;br&gt;→ シミュレータにモデルを読み直させる&lt;br&gt;&lt;span style="color:#b85450"&gt;この間の報酬は 0&lt;/span&gt;'><mxGeometry x="310" y="240" width="540" height="105" as="geometry"/></mxCell>
        <mxCell id="s3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;" value="&lt;b&gt;③ 実行への切り替え&lt;/b&gt;&lt;br&gt;関節の角度と速さに ±0.1 のずれを足す（&lt;b&gt;くじ&lt;/b&gt;）&lt;br&gt;→ &lt;b&gt;門&lt;/b&gt;: 初期の接触・床貫通・腕どうしの重なりを調べる&lt;br&gt;→ 当たれば物理を進めず 1 step で罰（到達は −1900）を返して終える&lt;br&gt;（Leader に「この形は駄目」が伝わる）"><mxGeometry x="310" y="360" width="540" height="110" as="geometry"/></mxCell>
        <mxCell id="g4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f1f6fd;" value="④ 実行の段 1 step（最大 1000 step くり返す）"><mxGeometry x="310" y="485" width="540" height="330" as="geometry"/></mxCell>
        <mxCell id="a" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;" value="(1) 指令を ±1 で切る"><mxGeometry x="325" y="525" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="b" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;" value="(2) × ギア比 ＝ 関節のトルク"><mxGeometry x="325" y="575" width="480" height="35" as="geometry"/></mxCell>
        <mxCell id="c" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;" value="(3) 物理を 4 tick 進める（1 tick 0.01 s → 1 step 0.04 s）"><mxGeometry x="325" y="620" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;fontSize=12;" value="env が毎 tick 足す: 前に関節の減衰 −b·q̇、後に速さの上限・可動域"><mxGeometry x="325" y="668" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="d" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;" value="(4) 状態を読む（関節の角度・速さ、リンクと箱の位置）"><mxGeometry x="325" y="718" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="e" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;" value="(5) 報酬と終わりの条件を計算し、観測を作って返す"><mxGeometry x="325" y="766" width="480" height="40" as="geometry"/></mxCell>
        <mxCell id="l01" parent="1" edge="1" source="s0" target="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l12" parent="1" edge="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l23" parent="1" edge="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l34" parent="1" edge="1" source="s3" target="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="loop" parent="1" edge="1" source="e" target="a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="次の&lt;br&gt;step"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="786"/><mxPoint x="830" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="gsim" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f2f2f2;" value="シミュレータ（層 E・F）"><mxGeometry x="920" y="70" width="330" height="760" as="geometry"/></mxCell>
        <mxCell id="load" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;fontSize=12;" value='&lt;b&gt;モデルを読み込む&lt;/b&gt;&lt;br&gt;MuJoCo 互換の XML → Choreonoid の .body に変換して読み直す&lt;br&gt;&lt;span style="color:#b85450"&gt;⚠️ 変換器が読まないもの: worldbody 直下の geom（壁など）・接触の値（solref など）・cylinder&lt;/span&gt;'><mxGeometry x="935" y="230" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="tick" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;" value="&lt;b&gt;Choreonoid ＋ 物理エンジン AIST&lt;/b&gt;&lt;br&gt;1 tick を計算する&lt;br&gt;当たり判定 → 接触の力 → 運動の積分&lt;br&gt;（中身は層 F）"><mxGeometry x="935" y="590" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="sim_note" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;fontSize=11;" value="env から見ると「XML を渡すとモデルができ、&lt;br&gt;トルクを渡すと 1 tick 先の状態が返る箱」"><mxGeometry x="935" y="400" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="p1" parent="1" edge="1" source="leader" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" value="編集の量"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p2" parent="1" edge="1" source="s2" target="leader" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" value="いまの形"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p3" parent="1" edge="1" source="follower" target="a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.17;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="指令"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p4" parent="1" edge="1" source="e" target="follower" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="観測・報酬"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="q1" parent="1" edge="1" source="s2" target="load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" value="XML"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="q2" parent="1" edge="1" source="c" target="tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="トルク"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="q3" parent="1" edge="1" source="tick" target="d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="状態"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gdet" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="env が決めていること（④ の (5) と、③ の門の中身）"><mxGeometry x="20" y="860" width="1230" height="230" as="geometry"/></mxCell>
        <mxCell id="o_obs" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;観測（方策へ返すもの、リンクごと）&lt;/b&gt;&lt;br&gt;・関節の角度・角速度&lt;br&gt;・箱と先端の相対位置（根元のノード）&lt;br&gt;・いまの形の値（長さ・太さ・ギア比）&lt;br&gt;・木の構造（深さ・つながり）"><mxGeometry x="35" y="900" width="290" height="175" as="geometry"/></mxCell>
        <mxCell id="o_rew" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;報酬（タスクで違うのは主にここ）&lt;/b&gt;&lt;br&gt;&lt;b&gt;到達&lt;/b&gt;: −（先端と目標の距離）&lt;br&gt;　　− 0.2 × 指令² の平均&lt;br&gt;&lt;b&gt;押し&lt;/b&gt;: 箱の x の速さ − 0.1 × |y の速さ|&lt;br&gt;　　− 0.2 × 指令² の平均&lt;br&gt;&lt;b&gt;形の段&lt;/b&gt;: 0"><mxGeometry x="340" y="900" width="290" height="175" as="geometry"/></mxCell>
        <mxCell id="o_done" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;話が終わる条件&lt;/b&gt;&lt;br&gt;・実行が 1000 step に達した（40 秒ぶん）&lt;br&gt;・状態の値が壊れた（NaN など）&lt;br&gt;・③ の門に当たった"><mxGeometry x="645" y="900" width="290" height="175" as="geometry"/></mxCell>
        <mxCell id="o_phys" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;env が物理エンジンの外で足しているもの&lt;/b&gt;&lt;br&gt;・指令を ±1 で切る&lt;br&gt;・関節の減衰 −b·q̇&lt;br&gt;・関節の速さの上限&lt;br&gt;・可動域（Choreonoid は守らない）&lt;br&gt;・壁の跳ね返り（ホッケーだけ。&lt;br&gt;　AIST は跳ね返りを扱えない）"><mxGeometry x="950" y="900" width="285" height="175" as="geometry"/></mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　報酬を変えるのと物理を変えるのは、どちらが env の仕事か&lt;/b&gt;&lt;br&gt;報酬は env の仕事（左から 2 つ目の箱）。物理の大半は AIST が計算するが、右端の箱の分だけは env が毎 tick 手で足している"><mxGeometry x="20" y="1120" width="400" height="115" as="geometry"/></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　壁の跳ね返りを env で計算するとは&lt;/b&gt;&lt;br&gt;AIST は跳ね返りを 0 として扱うので、tick の後にパックの速度を反射させて書き戻す。修論には「壁との接触は物理エンジンではなく速度反射としてモデル化した」と書く"><mxGeometry x="435" y="1120" width="400" height="115" as="geometry"/></mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;くじについて&lt;/b&gt;&lt;br&gt;どの話も ③ のずれのくじ 1 本。くじの種は run の seed で固定されるので、再生すると同じ順に同じくじが出る（話を増やして分布で見る理由）"><mxGeometry x="850" y="1120" width="400" height="115" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
