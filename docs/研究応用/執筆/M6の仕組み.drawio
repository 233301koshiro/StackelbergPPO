        <mxCell id="gjudge" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fdf0ef;" value="読んで判定する（学習の後）"><mxGeometry x="1030" y="340" width="230" height="370" as="geometry"/></mxCell>
        <mxCell id="j_replay" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;best.p を再生する&lt;/b&gt;&lt;br&gt;→ 軌跡・図を見る（目視）&lt;br&gt;→ 検査&lt;br&gt;（check_before_conclusion）"><mxGeometry x="1045" y="380" width="200" height="85" as="geometry"/></mxCell>
        <mxCell id="j_band" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;seed をまたいだ帯で読む&lt;/b&gt;&lt;br&gt;・成績の帯が重なるか&lt;br&gt;・収束した形&lt;br&gt;（ギア比・リンク長の合計）&lt;br&gt;例: 読み 56 は 5 seed"><mxGeometry x="1045" y="480" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="j_m7" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;M7 の第 2・3 層へ&lt;/b&gt;&lt;br&gt;向いていない理由と&lt;br&gt;直す方向を言葉で返す"><mxGeometry x="1045" y="605" width="200" height="85" as="geometry"/></mxCell>
        <mxCell id="e_out_j" parent="1" edge="1" source="gout" target="gjudge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_j1" parent="1" edge="1" source="j_replay" target="j_band" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_j2" parent="1" edge="1" source="j_band" target="j_m7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;要点 1　形の良し悪しは「動かした成績」でしか決まらない&lt;/b&gt;&lt;br&gt;Leader が形を決める 5 step の報酬は 0。Leader の評価には、その形で Follower が稼いだリターンがそのまま入る。だから学習を「形の判定器」として使える（修論 3.1・3.4）"><mxGeometry x="20" y="740" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;要点 2　1 回の学習で 2 つのものが出る&lt;/b&gt;&lt;br&gt;(i) その形でタスクをどこまでこなせたか（学習曲線・best の成績）&lt;br&gt;(ii) スケッチから来た形をどう直したか（収束した形）（修論 3.11）"><mxGeometry x="440" y="740" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;要点 3　判定は 1 本の run ではしない&lt;/b&gt;&lt;br&gt;同じ設定でも seed で結果がぶれる。seed を変えて何本か回し、帯が重なるかで読む。重なるなら順位を言わない（CLAUDE.md §5-2、系譜 9-34）"><mxGeometry x="860" y="740" width="400" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
