        <mxCell id="1" parent="0"/>
        <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;align=left;" value='&lt;b style="font-size:20px"&gt;層 F 物理エンジンの 1 tick&lt;/b&gt;'><mxGeometry x="20" y="10" width="470" height="40" as="geometry"/></mxCell>
        <mxCell id="lg0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;fontSize=11;" value="方策"><mxGeometry x="500" y="18" width="50" height="26" as="geometry"/></mxCell>
        <mxCell id="lg1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;fontSize=11;" value="物理エンジン AIST が計算"><mxGeometry x="558" y="18" width="170" height="26" as="geometry"/></mxCell>
        <mxCell id="lg2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;fontSize=11;" value="env が tick の前後で足す"><mxGeometry x="736" y="18" width="170" height="26" as="geometry"/></mxCell>
        <mxCell id="lg3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;fontSize=11;" value="失敗の型"><mxGeometry x="914" y="18" width="80" height="26" as="geometry"/></mxCell>
        <mxCell id="lg4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;fontSize=11;" value="本研究で変えた値"><mxGeometry x="1002" y="18" width="120" height="26" as="geometry"/></mxCell>
        <mxCell id="gtime" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="時間の刻み：方策は 1 step に 1 回だけ決め、物理はその間に 4 回進む"><mxGeometry x="20" y="70" width="1260" height="180" as="geometry"/></mxCell>
        <mxCell id="pol" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=6;fontSize=12;" value="&lt;b&gt;方策が行動を決める&lt;/b&gt;&lt;br&gt;1 step に 1 回&lt;br&gt;（指令はこの step の&lt;br&gt;あいだ同じ）"><mxGeometry x="40" y="115" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="tk0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;tick 1&lt;/b&gt;　0.01 s"><mxGeometry x="300" y="125" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="tk1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;tick 2&lt;/b&gt;　0.01 s"><mxGeometry x="510" y="125" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="tk2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;tick 3&lt;/b&gt;　0.01 s"><mxGeometry x="720" y="125" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="tk3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;" value="&lt;b&gt;tick 4&lt;/b&gt;　0.01 s"><mxGeometry x="930" y="125" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="tnote" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;align=left;" value="1 step ＝ 4 tick ＝ 0.04 s（1 話 1000 step ＝ 40 s）。物理だけを細かくすることもできる（&lt;b&gt;CNOID_SUBSTEPS&lt;/b&gt;。軸6 の run は 1 tick 0.0025 s × 16。制御の間隔 0.04 s は変えない）"><mxGeometry x="300" y="185" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="t0" parent="1" edge="1" source="pol" target="tk0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="指令"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="tz" parent="1" edge="1" source="tk3" target="gtick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" value="1 tick の中を拡大"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gtick" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="1 tick の中（左から右へ）"><mxGeometry x="20" y="280" width="1260" height="390" as="geometry"/></mxCell>
        <mxCell id="eb" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;tick の前（env）&lt;/b&gt;&lt;br&gt;・トルクを書く&lt;br&gt;　指令 × ギア比&lt;br&gt;・関節の減衰&lt;br&gt;　−b·q̇ をトルクに足す&lt;br&gt;（AIST は減衰を扱わない）"><mxGeometry x="35" y="335" width="205" height="200" as="geometry"/></mxCell>
        <mxCell id="gaist" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#eef7ec;" value="AIST の 1 tick（Choreonoid の中の物理エンジン）"><mxGeometry x="265" y="315" width="730" height="340" as="geometry"/></mxCell>
        <mxCell id="f1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value='&lt;b&gt;① 当たり判定（衝突検出）&lt;/b&gt;&lt;br&gt;重なっている組を探し、&lt;br&gt;接触点と深さを出す&lt;br&gt;&lt;br&gt;調べる組:&lt;br&gt;・腕 × 床、腕 × 箱、箱 × 床&lt;br&gt;・腕どうし（隣り合わない組だけ。&lt;br&gt;　&lt;span style="background:#fff2cc"&gt;自己干渉を足した&lt;/span&gt;）&lt;br&gt;&lt;br&gt;形はメッシュとして扱われる&lt;br&gt;（Coldet）'><mxGeometry x="280" y="355" width="225" height="285" as="geometry"/></mxCell>
        <mxCell id="f2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value='&lt;b&gt;② 接触の力（拘束ソルバー）&lt;/b&gt;&lt;br&gt;めり込みを押し戻す力と&lt;br&gt;摩擦の力を、反復で決める&lt;br&gt;（上限 25 回）&lt;br&gt;&lt;br&gt;・摩擦係数 0.5（既定）&lt;br&gt;・跳ね返り 0（扱えない）&lt;br&gt;・深すぎる接触は捨てる:&lt;br&gt;　&lt;span style="background:#fff2cc"&gt;0.05 m → 1.0 m に変えた&lt;br&gt;　（Bug 57）&lt;/span&gt;'><mxGeometry x="520" y="355" width="225" height="285" as="geometry"/></mxCell>
        <mxCell id="f3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;③ 運動の積分&lt;/b&gt;&lt;br&gt;トルク ＋ 接触の力から&lt;br&gt;加速度を出し、&lt;br&gt;&lt;b&gt;速度を更新 → その速度で&lt;br&gt;位置を進める&lt;/b&gt;&lt;br&gt;（半陰的オイラー）&lt;br&gt;&lt;br&gt;刻みが粗いと、速い物は&lt;br&gt;1 tick で深く入る"><mxGeometry x="760" y="355" width="220" height="285" as="geometry"/></mxCell>
        <mxCell id="ea" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;tick の後（env）&lt;/b&gt;&lt;br&gt;・関節の速さの上限で切る&lt;br&gt;　（位置も進め直す。Bug 65）&lt;br&gt;・可動域で止める&lt;br&gt;　（AIST は守らない）&lt;br&gt;・壁の跳ね返り（ホッケー）"><mxGeometry x="1020" y="335" width="245" height="185" as="geometry"/></mxCell>
        <mxCell id="sync" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=11;" value='&lt;b&gt;tick が終わるのを待つ&lt;/b&gt;&lt;br&gt;（&lt;span style="background:#fff2cc"&gt;CNOID_TICK_SYNC&lt;/span&gt;）&lt;br&gt;待たないと、計算中の状態を env が読み書きし、物理が毎回ずれていた（Bug 64）'><mxGeometry x="1020" y="530" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="k1" parent="1" edge="1" source="eb" target="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="k2" parent="1" edge="1" source="f1" target="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="接触点&lt;br&gt;と深さ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="k3" parent="1" edge="1" source="f2" target="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="接触の&lt;br&gt;力"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="k4" parent="1" edge="1" source="f3" target="ea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" value="新しい角度&lt;br&gt;・速さ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gfail" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="「床にめり込む」「すり抜ける」は、どこの失敗でありうるか"><mxGeometry x="20" y="700" width="1260" height="330" as="geometry"/></mxCell>
        <mxCell id="m1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;① の失敗：接触が返らない&lt;/b&gt;&lt;br&gt;当たり判定が重なりを見つけないと、力が出ず、そのまま通り抜ける。&lt;br&gt;&lt;br&gt;&lt;b&gt;四脚の脛 × 床（Bug 103）&lt;/b&gt;: 床の下にある場面の 50〜76 % で接触点が 1 つも無かった。0.5 m 角の箱を敷いた床では減る。反復の上限や捨てる深さを変えても件数は変わらない → 力ではなく判定の側。仕組みは未特定"><mxGeometry x="35" y="740" width="300" height="275" as="geometry"/></mxCell>
        <mxCell id="m2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;② の失敗：返った接触を捨てる&lt;/b&gt;&lt;br&gt;深すぎる接触をソルバーが無視すると、押し戻されないまま重なりが残る。&lt;br&gt;&lt;br&gt;&lt;b&gt;押しの長い腕（Bug 57）&lt;/b&gt;: 1 step に 5 cm を越えて台座へめり込み、捨てられて 175 mm すり抜けたまま強く打っていた。閾値を 1.0 m にして取り直した"><mxGeometry x="345" y="740" width="300" height="275" as="geometry"/></mxCell>
        <mxCell id="m3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;③ の失敗：1 tick で動きすぎる&lt;/b&gt;&lt;br&gt;刻みが粗いと、速く当たったときに 1 tick で深く入ってから押し戻される。薄い物は一度に通り抜けうる（想定問答 Q22 の限界）。&lt;br&gt;&lt;br&gt;&lt;b&gt;軸6 の 1/5 の腕&lt;/b&gt;: 刻みを 0.0025 s にすると、速く床に当たったときのめり込みが −10.5 → −1.1 mm（系譜 9-327）"><mxGeometry x="655" y="740" width="300" height="275" as="geometry"/></mxCell>
        <mxCell id="m4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" value="&lt;b&gt;極端な食い込み：値が壊れる&lt;/b&gt;&lt;br&gt;太いリンクが静的な箱に深く食い込むと、1 tick の中で状態が NaN になった。&lt;br&gt;&lt;br&gt;&lt;b&gt;ホッケーの板（Bug 68）&lt;/b&gt;: 板だけを 3 m 上へ動かすと 5 話とも有限に戻った。NaN は検査で必ず拾う（不変条件）"><mxGeometry x="965" y="740" width="300" height="275" as="geometry"/></mxCell>
        <mxCell id="mf1" parent="1" edge="1" source="m1" target="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mf2" parent="1" edge="1" source="m2" target="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.34;entryY=1;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mf3" parent="1" edge="1" source="m3" target="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　1 step（0.04 s）のあいだに、物理エンジンは何回、何をするか&lt;/b&gt;&lt;br&gt;4 回。毎回 ① 当たり判定 → ② 接触の力 → ③ 積分。その前に env がトルクと減衰を書き、後に速さ・可動域で切る（橙）"><mxGeometry x="20" y="1060" width="410" height="125" as="geometry"/></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　「床にめり込む」はどちらの失敗か。四脚は？&lt;/b&gt;&lt;br&gt;判定（①）と力（②）のどちらでもありうる。四脚は判定の側: 接触点が 1 つも返っておらず、力の設定を変えても件数が同じだった（Bug 103）"><mxGeometry x="445" y="1060" width="410" height="125" as="geometry"/></mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;審査での言い方&lt;/b&gt;&lt;br&gt;当たり判定・接触の力・積分の作りは AIST のまま。値を変えたのは、腕どうしの当たり判定を足したことと、深い接触を捨てない閾値の 2 つ（値の変更表 §2）。ほかに tick の完了を待つようにした（Bug 64）。黄色がこの 3 つ"><mxGeometry x="870" y="1060" width="410" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="m6_values" name="5 層 G モデルの値">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;align=left;" value='&lt;b style="font-size:20px"&gt;層 G ロボットのモデルの値：どこまで本物か&lt;/b&gt;'><mxGeometry x="20" y="10" width="470" height="40" as="geometry"/></mxCell>
        <mxCell id="lg0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;fontSize=11;" value="形から来る値"><mxGeometry x="520" y="18" width="100" height="26" as="geometry"/></mxCell>
        <mxCell id="lg1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;fontSize=11;" value="実在の部品から導いた値"><mxGeometry x="628" y="18" width="160" height="26" as="geometry"/></mxCell>
        <mxCell id="lg2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;fontSize=11;" value="根拠の無いまま宣言して使う値"><mxGeometry x="796" y="18" width="190" height="26" as="geometry"/></mxCell>
        <mxCell id="lg3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=13;arcSize=6;fontSize=11;" value="近似・単純化"><mxGeometry x="994" y="18" width="100" height="26" as="geometry"/></mxCell>
        <mxCell id="lg4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;fontSize=11;" value="掛け方を直した"><mxGeometry x="1102" y="18" width="110" height="26" as="geometry"/></mxCell>
        <mxCell id="gparts" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcfcfc;" value="モデルの部品と、付いている値"><mxGeometry x="20" y="70" width="370" height="620" as="geometry"/></mxCell>
        <mxCell id="p0" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value='&lt;b&gt;台座の柱（縦型）&lt;/b&gt;&lt;br&gt;&lt;span style="background:#fafafa;border:1px solid #b3b3b3;padding:0 3px"&gt;向き・長さ・太さは描いたまま固定&lt;/span&gt;&lt;br&gt;（倒れて床を這う腕になった。Bug 58）'><mxGeometry x="35" y="110" width="340" height="75" as="geometry"/></mxCell>
        <mxCell id="p1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value='&lt;b&gt;リンク（棒）&lt;/b&gt;&lt;br&gt;&lt;span style="background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px"&gt;長さ&lt;/span&gt; &lt;span style="background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px"&gt;太さ&lt;/span&gt;&lt;br&gt;&lt;span style="background:#d5e8d4;border:1px solid #82b366;padding:0 3px"&gt;密度 → 質量&lt;/span&gt;&lt;br&gt;&lt;span style="background:#fafafa;border:1px solid #b3b3b3;padding:0 3px"&gt;形はカプセル&lt;/span&gt; &lt;span style="background:#fafafa;border:1px solid #b3b3b3;padding:0 3px"&gt;質量は中実の式&lt;/span&gt;&lt;br&gt;&lt;span style="background:#fafafa;border:1px solid #b3b3b3;padding:0 3px"&gt;隣り合うリンクどうしは当たらない&lt;/span&gt;'><mxGeometry x="35" y="200" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="p2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value='&lt;b&gt;関節（回転のヒンジ）&lt;/b&gt;&lt;br&gt;&lt;span style="background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px"&gt;位置・つながり（スケッチから）&lt;/span&gt;&lt;br&gt;&lt;span style="background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px"&gt;軸（利用者が与える）&lt;/span&gt;&lt;br&gt;&lt;span style="background:#ffe6cc;border:1px solid #d79b00;padding:0 3px"&gt;可動域&lt;/span&gt; &lt;span style="background:#ffe6cc;border:1px solid #d79b00;padding:0 3px"&gt;減衰 b&lt;/span&gt;'><mxGeometry x="35" y="365" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="p3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value='&lt;b&gt;モーター（アクチュエータ）&lt;/b&gt;&lt;br&gt;&lt;span style="background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px"&gt;ギア比 ＝ 最大トルク（探索する）&lt;/span&gt;&lt;br&gt;&lt;span style="background:#d5e8d4;border:1px solid #82b366;padding:0 3px"&gt;最大トルクの上限 150 N·m&lt;/span&gt;&lt;br&gt;&lt;span style="background:#d5e8d4;border:1px solid #82b366;padding:0 3px"&gt;速さの上限 3.14 rad/s&lt;/span&gt;&lt;br&gt;&lt;span style="background:#d5e8d4;border:1px solid #82b366;padding:0 3px"&gt;回転子の慣性 1.71 kg·m²&lt;/span&gt;'><mxGeometry x="35" y="500" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="g1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f3f8fe;" value="形から来る値"><mxGeometry x="410" y="70" width="425" height="300" as="geometry"/></mxCell>
        <mxCell id="v1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;スケッチ → M3〜M5 が決め、長さ・太さ・ギア比は Leader が探索する&lt;/b&gt;&lt;br&gt;&lt;br&gt;・関節の位置・リンクのつながり（スケッチのまま固定）&lt;br&gt;・関節の軸（平面モード・縦型モード。&lt;b&gt;形から推定はしない&lt;/b&gt;）&lt;br&gt;・リンクの長さ: 設計長の 0.5〜2.93 倍の範囲（縦型）&lt;br&gt;・太さ&lt;br&gt;・ギア比（＝ 関節の最大トルク）: 縦型 25〜150・平面 20〜150 N·m の範囲"><mxGeometry x="425" y="105" width="395" height="250" as="geometry"/></mxCell>
        <mxCell id="g2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#eef7ec;" value="実在の部品から導いた値（*_phys、系譜 9-246）"><mxGeometry x="855" y="70" width="425" height="300" as="geometry"/></mxCell>
        <mxCell id="v2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;UR5e（産業用アーム）とアルミパイプから&lt;/b&gt;&lt;br&gt;&lt;br&gt;・リンクの密度 189.9〜294.2 kg/m³（A6061・肉厚 2 mm のパイプの実効密度。形ごと）&lt;br&gt;・最大トルクの上限 150 N·m（UR5e の関節トルク）&lt;br&gt;・回転子の慣性 1.71 kg·m²（UR5e のモーター＋減速機 × 減速比 100²）&lt;br&gt;・速さの上限 3.14 rad/s（UR5e の最大速度 180°/s）&lt;br&gt;・長さの探索幅の上限 2.93 倍（UR5e の 150 N·m で自重を支えられる最大の伸び。e2e_a1v で導き、縦型すべてに流用）"><mxGeometry x="870" y="105" width="395" height="250" as="geometry"/></mxCell>
        <mxCell id="g3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fff5e8;" value="根拠の無いまま宣言して使う値"><mxGeometry x="410" y="390" width="425" height="300" as="geometry"/></mxCell>
        <mxCell id="v3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;修論では「宣言して使う」と書く（想定問答 Q15）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・関節の減衰 b ＝ 1 N·m·s/rad（原論文のまま）&lt;br&gt;・可動域: 平面 ±180°・縦型 ±90°（第1層の判定に効かないことは確かめた）&lt;br&gt;・制御コストの係数 0.2（報酬の項。層 D）&lt;br&gt;・接触の摩擦 0.5（Choreonoid の既定。変換器が XML の摩擦を読まない）&lt;br&gt;・時間の刻み 0.01 s、1 話 1000 step（原論文のまま）"><mxGeometry x="425" y="425" width="395" height="250" as="geometry"/></mxCell>
        <mxCell id="g4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f5f5f5;" value="近似・単純化（全条件で同じ）"><mxGeometry x="855" y="390" width="425" height="300" as="geometry"/></mxCell>
        <mxCell id="v4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;全条件が同じ近似を共有するので、順序の比較は成り立つ（Q33）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・リンクはカプセル、質量は中実の式（太さを変えると、同じ太さの実在のパイプの 0.55〜2.75 倍）&lt;br&gt;・隣り合うリンクは当たらない（120° を超えて折り返せる。Q18）&lt;br&gt;・台座の柱は描いたまま&lt;br&gt;・跳ね返りはほぼ 0（実効の反発係数 約 0.055。AIST が扱えない）"><mxGeometry x="870" y="425" width="395" height="250" as="geometry"/></mxCell>
        <mxCell id="gfix" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fffbea;" value="値の掛け方を直したもの（値は同じでも、移植で掛け方が誤っていた。全部直して取り直した）"><mxGeometry x="20" y="715" width="1260" height="135" as="geometry"/></mxCell>
        <mxCell id="x1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;制御入力を ±1 で切る&lt;/b&gt;&lt;br&gt;切っておらず、トルクが上限の最大 2.7 倍出ていた（Bug 60）"><mxGeometry x="35" y="750" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="x2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;減衰をトルク −b·q̇ で掛ける&lt;/b&gt;&lt;br&gt;箱用の式の流用で、強さが腕の重さで 0.24〜30 倍変わっていた（Bug 61）"><mxGeometry x="345" y="750" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="x3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;速さの上限で位置も進め直す&lt;/b&gt;&lt;br&gt;実効の最高速度が 6〜57 % 上回り、ギア比と太さで変わっていた（Bug 65）"><mxGeometry x="655" y="750" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="x4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=6;align=left;spacingLeft=8;fontSize=12;" value="&lt;b&gt;箱・パックの回転子の慣性を 0 に&lt;/b&gt;&lt;br&gt;既定値が対象にも掛かり、パックが実効 34 倍重かった（Bug 62）"><mxGeometry x="965" y="750" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 1　実在の部品から導いた値と、根拠なく決めた値を 2 つずつ&lt;/b&gt;&lt;br&gt;実在: 回転子の慣性 1.71 kg·m²（UR5e）、最大トルクの上限 150 N·m（UR5e）、ほかに密度・速さの上限。&lt;br&gt;根拠なし: 減衰 b ＝ 1、可動域、ほかに制御コスト・摩擦"><mxGeometry x="20" y="880" width="410" height="135" as="geometry"/></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;問い 2　物理を少し変えると判定は変わるか（Q38）&lt;/b&gt;&lt;br&gt;敏感な形はある（tick の完了を待たずに再生すると、長腕 seed 1 の誤差 1.35 → 27.59 mm、中間の腕は変わらない）。比べる条件はすべて同じ物理で学習・評価するので順序は比べられる。箱の質量・滑りを 0.5〜2 倍にしても押しの順位は保たれた（Q39）"><mxGeometry x="445" y="880" width="410" height="135" as="geometry"/></mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;言わないこと&lt;/b&gt;&lt;br&gt;・形の差を「慣性」で説明しない: 根元の関節の慣性のうち、リンクの形の寄与は 1.8〜40 %（大部分は回転子。系譜 9-253）。幾何で説明できないかを先に見る&lt;br&gt;・絶対的な性能（何 m 押せるか）は主張しない"><mxGeometry x="870" y="880" width="410" height="135" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
