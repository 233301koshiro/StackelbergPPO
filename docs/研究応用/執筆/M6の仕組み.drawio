        <mxCell id="pt" parent="1" edge="1" source="py4" target="t_world" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="組み立て・&lt;br&gt;tick を進める・&lt;br&gt;状態の読み書き"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
