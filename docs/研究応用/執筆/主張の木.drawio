ot;#555555&quot;&gt;2.4・2.4.1・1,066 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1464" y="558" width="226" height="70" as="geometry"/></mxCell><mxCell id="n89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n80" target="n88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n90" value="&lt;b&gt;F5&lt;/b&gt; 設計へのフィードバック（反実仮想説明）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.4.2・907 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1464" y="642" width="226" height="70" as="geometry"/></mxCell><mxCell id="n91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n80" target="n90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n92" value="&lt;b&gt;F6&lt;/b&gt; 本研究の位置づけ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.5・1,535 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1464" y="726" width="226" height="70" as="geometry"/></mxCell><mxCell id="n93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n80" target="n92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n94" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;実線の子（A〜D）はどれが欠けても根が成り立たない（AND）。点線の子（E・F）は根の成立には要らず、意義・適用を足す。&lt;br&gt;字数は本文（執筆メモ・表の外の注記を除く）。1 ページ ≒ 1,100 字（表・図を含む平均）。2026-10-23 時点。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="560" height="70" as="geometry"/></mxCell><mxCell id="n95" value="方法・条件（何をしたか）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="1260" width="185" height="40" as="geometry"/></mxCell><mxCell id="n96" value="結果（主張の証拠）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1260" width="185" height="40" as="geometry"/></mxCell><mxCell id="n97" value="位置づけ（第2章）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1260" width="185" height="40" as="geometry"/></mxCell><mxCell id="n98" value="★ 刈らない（修論でいちばん伝えたい方法論）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#B85450;fontSize=10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1240" y="1260" width="185" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>