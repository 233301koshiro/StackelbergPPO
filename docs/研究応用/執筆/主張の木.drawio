<mxfile host="app.diagrams.net"><diagram id="claimtree" name="主張の木"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2070" pageHeight="1510" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;根&lt;/b&gt;&lt;br&gt;ハードウェアの専門知識が無い人でも、手描きスケッチからロボット形態のタスク適性をシミュレーションで判定でき、向いていなければ直し方を受け取れるシステムが成り立つ&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;5.1・1.3（第1章 4 p・第5章 6 p はこの木の要約）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;fontColor=#FFFFFF;strokeColor=#1F3864;fontSize=13;" vertex="1" parent="1"><mxGeometry x="605.0" y="40" width="820" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;A 入力&lt;/b&gt;&lt;br&gt;スケッチから、専門知識なしでシミュレーション用のモデルが作れる&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ1・軸1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="300" height="96" as="geometry"/></mxCell><mxCell id="n5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;A1&lt;/b&gt; 地図: システム全体像（M1〜M7、図 3.1）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.5・1,303 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=4;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="300" width="300" height="58" as="geometry"/></mxCell><mxCell id="n7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;A2&lt;/b&gt; 関節の情報が無い問題を、目印の規約で避ける（M1）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.6・1,002 字 ＋ 付録A 約 4 p&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="54" y="368" width="300" height="58" as="geometry"/></mxCell><mxCell id="n9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;A2a&lt;/b&gt; 目印が規約どおりの個数で出る・描いた比が保たれる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;表 4.5 の M1 行&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="76" y="436" width="278" height="58" as="geometry"/></mxCell><mxCell id="n11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;A2b&lt;/b&gt; なぜ: 推定器は精度に限界がある&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.2・1,082 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="76" y="504" width="278" height="58" as="geometry"/></mxCell><mxCell id="n13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;A3&lt;/b&gt; 目印から関節とリンクを自動で取り出す（M2→M3→M4）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.7〜3.9・1,411 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="54" y="572" width="300" height="58" as="geometry"/></mxCell><mxCell id="n15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n4" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;A3a&lt;/b&gt; シードを固定すると外形の量が一致する（M2）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;表 4.5 の M2 行&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="76" y="640" width="278" height="58" as="geometry"/></mxCell><mxCell id="n17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;A3b&lt;/b&gt; 基準色の自動較正で 2 件とも正しい位置で検出、目印なしは停止（M3）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;表 4.5 の M3 行&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="76" y="708" width="278" height="58" as="geometry"/></mxCell><mxCell id="n19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;A3c&lt;/b&gt; 実効リーチが公称と一致・被覆 21.4 %（M4）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;表 4.5 の M4 行・4.3.2 本文&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="76" y="776" width="278" height="58" as="geometry"/></mxCell><mxCell id="n21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n14" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;A4&lt;/b&gt; モデルが学習系にそのまま入る（M5）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.10・622 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="54" y="844" width="300" height="58" as="geometry"/></mxCell><mxCell id="n23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n4" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;A4a&lt;/b&gt; コードを変えずに受理され、学習が最後まで走る&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.3.1・265 字・表 4.5 の M5 行 ✂ 表 4.5 へ吸収&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="76" y="912" width="278" height="58" as="geometry"/></mxCell><mxCell id="n25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;B 判定&lt;/b&gt;&lt;br&gt;中核の co-design が、形態のタスク適性を正しく判定する&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ2・軸2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="180" width="300" height="96" as="geometry"/></mxCell><mxCell id="n27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;B1&lt;/b&gt; なぜ: co-design は形を自動設計する道具だが、判定器に転用できる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.3・1,572 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="384" y="300" width="300" height="58" as="geometry"/></mxCell><mxCell id="n29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;B2&lt;/b&gt; 前提: 枠組み（Stackelberg PPO）と M6 の流れ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.1〜3.4・2,681 字 ＋ 3.11・331 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="384" y="368" width="300" height="58" as="geometry"/></mxCell><mxCell id="n31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n26" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;B3&lt;/b&gt; 前提: 物理の値は実在の部材とアクチュエータから（表 4.1・4.2）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.1.1・3,267 字 ＋ 付録D.3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="384" y="436" width="300" height="58" as="geometry"/></mxCell><mxCell id="n33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n26" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;B4&lt;/b&gt; 前提: タスク・統制条件・ハイパーパラメータ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.1.2・765 字 ＋ 4.1.3・244 字 ＋ 付録D.1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="384" y="504" width="300" height="58" as="geometry"/></mxCell><mxCell id="n35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n26" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;B5&lt;/b&gt; 前提: 帯が重ならないときだけ順位を言う&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.2.2・641 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="384" y="572" width="300" height="58" as="geometry"/></mxCell><mxCell id="n37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n26" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;B6&lt;/b&gt; 「正しく判定する」＝ R1 ∧ R2 ∧ R3（R4 は D へ）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.2・4.2.1・1,675 字（表 4.3 は刈った）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=4;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="384" y="640" width="300" height="58" as="geometry"/></mxCell><mxCell id="n39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n26" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;R1&lt;/b&gt; 形を最適化することが要る&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.2.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="406" y="708" width="278" height="58" as="geometry"/></mxCell><mxCell id="n41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n38" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;B7&lt;/b&gt; 形を凍結すると成績が下がる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.1・145 字（???）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="428" y="776" width="256" height="58" as="geometry"/></mxCell><mxCell id="n43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n40" target="n42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;R2&lt;/b&gt; タスクを変えると収束する形が分かれる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.2.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="406" y="844" width="278" height="58" as="geometry"/></mxCell><mxCell id="n45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n38" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;B8&lt;/b&gt; 縦型 A1v のギア比が到達と押しで分かれる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.2・783 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="428" y="912" width="256" height="58" as="geometry"/></mxCell><mxCell id="n47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n44" target="n46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b&gt;R3&lt;/b&gt; 渡された形に正しく順位を付ける&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.2.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="406" y="980" width="278" height="58" as="geometry"/></mxCell><mxCell id="n49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n38" target="n48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;B9&lt;/b&gt; 届かない短腕を見分ける（前向き判定）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.3.1・821 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="428" y="1048" width="256" height="58" as="geometry"/></mxCell><mxCell id="n51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n48" target="n50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;B10&lt;/b&gt; 順位がタスクで入れ替わる（大きさを測っていない）← B9 の 2 形＋中間&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.3.2・1,774 字 ✂ 目的・設定・機構・幾何診断との対応&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="428" y="1116" width="256" height="58" as="geometry"/></mxCell><mxCell id="n53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n48" target="n52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b&gt;B11&lt;/b&gt; 幾何では区別できない配分を区別する ← B10 の中間と同じ条件&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.3.3・821 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="428" y="1184" width="256" height="58" as="geometry"/></mxCell><mxCell id="n55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n48" target="n54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;B11w&lt;/b&gt; なぜ: 作業空間などの幾何の指標では足りない&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.4.1・1,066 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="450" y="1252" width="234" height="58" as="geometry"/></mxCell><mxCell id="n57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n54" target="n56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;C 出力&lt;/b&gt;&lt;br&gt;向いていなければ、実際に使える直し方を返す&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ3・軸3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="180" width="300" height="96" as="geometry"/></mxCell><mxCell id="n59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n58"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n60" value="&lt;b&gt;C1&lt;/b&gt; 診断は不適合を正しく見抜く（三層診断）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.12・3.12.1・1,044 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="714" y="300" width="300" height="58" as="geometry"/></mxCell><mxCell id="n61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n58" target="n60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b&gt;C1a&lt;/b&gt; 学習なしで判定を再現する（6 条件）← B10 の run を使う&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.1・993 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="736" y="368" width="278" height="58" as="geometry"/></mxCell><mxCell id="n63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n60" target="n62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;C2&lt;/b&gt; 直し方は実際に使える（助言を入れ直す閉ループ）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.2・241 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="714" y="436" width="300" height="58" as="geometry"/></mxCell><mxCell id="n65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n58" target="n64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n66" value="&lt;b&gt;C2a&lt;/b&gt; 指針どおり伸ばせば達成する（1.99 倍・2.11 倍）← 相手は B9 の短腕&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.4・863 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="736" y="504" width="278" height="58" as="geometry"/></mxCell><mxCell id="n67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n64" target="n66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n68" value="&lt;b&gt;C2w&lt;/b&gt; なぜ「N 倍に伸ばせ」: 反実仮想説明・リコース&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.4.2・907 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="758" y="572" width="256" height="58" as="geometry"/></mxCell><mxCell id="n69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n66" target="n68"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n70" value="&lt;b&gt;C2b&lt;/b&gt; ★ 閉ループが指針の欠陥を見つけた → 実行可能性は判定の正しさと別に壊れる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.3・256 字 ＋ 5.2.4&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="736" y="640" width="278" height="58" as="geometry"/></mxCell><mxCell id="n71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n64" target="n70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;C3&lt;/b&gt; 減らす向きは候補を出すだけ（閾値は候補生成器、採否は帯）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.12.2・227 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="714" y="708" width="300" height="58" as="geometry"/></mxCell><mxCell id="n73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n58" target="n72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n74" value="&lt;b&gt;C3a&lt;/b&gt; 閾値が挙げなかった関節を固定した＝見落としの実例&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.5・689 字 ✂ 冒頭（3.12.2 と同じ）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="736" y="776" width="278" height="58" as="geometry"/></mxCell><mxCell id="n75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n72" target="n74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n76" value="&lt;b&gt;D 一巡&lt;/b&gt;&lt;br&gt;入力から直し方まで 1 本につながり、使える時間で回る&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ1・RQ2 の学習量・軸4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="180" width="300" height="96" as="geometry"/></mxCell><mxCell id="n77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;D1&lt;/b&gt; 1 本につながる ← A4a・B9・B10・C のまとめ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.1・306 字 ✂ 1 文に&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1044" y="300" width="300" height="58" as="geometry"/></mxCell><mxCell id="n79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n76" target="n78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n80" value="&lt;b&gt;D1l&lt;/b&gt; 限定: 手描きの実走は 5 件、M1・M2 は人手&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.4・575 字 ＋ 付録D.2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1066" y="368" width="278" height="58" as="geometry"/></mxCell><mxCell id="n81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n78" target="n80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n82" value="&lt;b&gt;D2&lt;/b&gt; 使える時間で回る（学習の要らない工程は数秒）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.2・400 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1044" y="436" width="300" height="58" as="geometry"/></mxCell><mxCell id="n83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n76" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n84" value="&lt;b&gt;D3&lt;/b&gt; R4 判定に要る学習量&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.3・843 字 ＋ 付録D.4&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1066" y="504" width="278" height="58" as="geometry"/></mxCell><mxCell id="n85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n82" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n86" value="&lt;b&gt;E 題材&lt;/b&gt;&lt;br&gt;元の題材（エアホッケー）にも適用できる&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;根の成立には要らない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1360" y="180" width="300" height="96" as="geometry"/></mxCell><mxCell id="n87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n88" value="&lt;b&gt;E3&lt;/b&gt; 打ち込みの結果&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.7.3・369 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1374" y="300" width="300" height="58" as="geometry"/></mxCell><mxCell id="n89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n86" target="n88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n90" value="&lt;b&gt;E1&lt;/b&gt; 前提: ロボットと台&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.7.1・574 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1396" y="368" width="278" height="58" as="geometry"/></mxCell><mxCell id="n91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n88" target="n90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n92" value="&lt;b&gt;E2&lt;/b&gt; 前提: 報酬と学習条件&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.7.2・319 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1396" y="436" width="278" height="58" as="geometry"/></mxCell><mxCell id="n93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n88" target="n92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n94" value="&lt;b&gt;F 位置づけ&lt;/b&gt;&lt;br&gt;既存の研究だけでは、これができない（根の意義）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;第2章（7 p）・根の成立には要らない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#333333;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1690" y="180" width="300" height="96" as="geometry"/></mxCell><mxCell id="n95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n96" value="&lt;b&gt;F6&lt;/b&gt; 三領域を 1 本のシステムにした差分（表 2.1）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.5・1,535 字&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1704" y="300" width="300" height="58" as="geometry"/></mxCell><mxCell id="n97" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n94" target="n96"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n98" value="&lt;b&gt;F1&lt;/b&gt; スケッチからのモデリングは形を作るまで&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.1・805 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1726" y="368" width="278" height="58" as="geometry"/></mxCell><mxCell id="n99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n96" target="n98"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n100" value="&lt;b&gt;F2&lt;/b&gt; → 可動構造の推定（A2b で使う）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=4;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1726" y="436" width="278" height="58" as="geometry"/></mxCell><mxCell id="n101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n96" target="n100"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n102" value="&lt;b&gt;F3&lt;/b&gt; → co-design（B1 で使う）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=4;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1726" y="504" width="278" height="58" as="geometry"/></mxCell><mxCell id="n103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n96" target="n102"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;F4&lt;/b&gt; → タスク適合性の判定（B11w で使う）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.4.1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=4;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1726" y="572" width="278" height="58" as="geometry"/></mxCell><mxCell id="n105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n96" target="n104"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;F5&lt;/b&gt; → 設計へのフィードバック（C2w で使う）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;2.4.2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=4;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1726" y="640" width="278" height="58" as="geometry"/></mxCell><mxCell id="n107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=10;" edge="1" parent="1" source="n96" target="n106"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n108" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;字下げが 1 段深いほど根から遠い。実線の子（A〜D）はどれが欠けても根が成り立たない（AND）。点線の子（E・F）は根の成立には要らず、適用と意義を足す。&lt;br&gt;「← X」は枝をまたいで X の実験・結果を使っていること。字数は本文（執筆メモ・注記を除く）、1 ページ ≒ 1,100 字。2026-10-23 版 3。✂ は D-6（10-26）で刈る候補（50ページ化計画）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="620" height="80" as="geometry"/></mxCell><mxCell id="n109" value="主張" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="690" y="1350" width="235" height="38" as="geometry"/></mxCell><mxCell id="n110" value="根拠（実験・確認の結果）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="1350" width="235" height="38" as="geometry"/></mxCell><mxCell id="n111" value="共通の前提（多くの根拠が頼る条件）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="1350" width="235" height="38" as="geometry"/></mxCell><mxCell id="n112" value="なぜこの作りか（第2章の対応）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440" y="1350" width="235" height="38" as="geometry"/></mxCell><mxCell id="n113" value="地図・定義・参照（主張でも根拠でもない）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="690" y="1396" width="235" height="38" as="geometry"/></mxCell><mxCell id="n114" value="限定（主張の範囲を狭める）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="1396" width="235" height="38" as="geometry"/></mxCell><mxCell id="n115" value="★ 刈らない（いちばん伝えたい方法論）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#B85450;fontSize=10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1190" y="1396" width="235" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>