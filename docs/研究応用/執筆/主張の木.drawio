le;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;D1&lt;/b&gt; システムとしてつながる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.1・271 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="904" y="306" width="226" height="70" as="geometry"/></mxCell><mxCell id="n65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n62" target="n64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n66" value="&lt;b&gt;D2&lt;/b&gt; 一巡の時間（学習の要らない工程は数秒）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.2・400 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="904" y="390" width="226" height="70" as="geometry"/></mxCell><mxCell id="n67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n62" target="n66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n68" value="&lt;b&gt;D3&lt;/b&gt; R4 判定に要る学習量&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.6.3・843 字 ＋ 付録D.4 711 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="904" y="474" width="226" height="70" as="geometry"/></mxCell><mxCell id="n69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entr