t="n74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n76" value="&lt;b&gt;E2&lt;/b&gt; 報酬と学習条件&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.7.2・319 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1184" y="390" width="226" height="70" as="geometry"/></mxCell><mxCell id="n77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n72" target="n76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;E3&lt;/b&gt; 打ち込みの結果&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.7.3・369 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1184" y="474" width="226" height="70" as="geometry"/></mxCell><mxCell id="n79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n72" target="n78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n80" value="&lt;b&gt;F 位置づけ&lt;/b&gt;&lt;br&gt;既存の研究だけでは、これができない（根の意義）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;第2章（7 p）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#333333;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1440" y="180" width="250" height="96" as="geometry"/></mxCell><mxCell id="n81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n82" value="&lt;b&gt;F1&lt;