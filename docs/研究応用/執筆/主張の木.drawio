<mxfile host="app.diagrams.net"><diagram id="claimtree" name="主張の木"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="1410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;根&lt;/b&gt;&lt;br&gt;ハードウェアの専門知識が無い人でも、手描きスケッチからロボット形態のタスク適性をシミュレーションで判定でき、向いていなければ直し方を受け取れるシステムが成り立つ&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;5.1・1.3（第1章 4 p・第5章 7 p はこの木の要約）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;fontColor=#FFFFFF;strokeColor=#1F3864;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485.0" y="40" width="760" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;A 入力&lt;/b&gt;&lt;br&gt;スケッチから、専門知識なしでシミュレーション用のモデルが作れる&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ1・軸1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="96" as="geometry"/></mxCell><mxCell id="n5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;A1&lt;/b&gt; システム全体像（M1〜M7 の流れ、図 3.1）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.5・1,303 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="306" width="226" height="70" as="geometry"/></mxCell><mxCell id="n7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;A2&lt;/b&gt; 関節の目印を画像に描かせ、可動構造の推定を避ける（M1）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.6・1,002 字 ＋ 付録A 約 4 p&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="390" width="226" height="70" as="geometry"/></mxCell><mxCell id="n9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;A3&lt;/b&gt; 画像から立体を作る（M2、外部サービス）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.7・273 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="474" width="226" height="70" as="geometry"/></mxCell><mxCell id="n11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;A4&lt;/b&gt; 目印から関節を見つけ、リンクに分ける（M3）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.8・577 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="558" width="226" height="70" as="geometry"/></mxCell><mxCell id="n13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;A5&lt;/b&gt; リンクの長さと太さを取り出す（M4）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.9・561 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="642" width="226" height="70" as="geometry"/></mxCell><mxCell id="n15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;A6&lt;/b&gt; シミュレーション用のモデルを作る（M5）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.10・622 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="726" width="226" height="70" as="geometry"/></mxCell><mxCell id="n17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;A7&lt;/b&gt; 学習系がコードを変えずにモデルを受け取る&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.3.1・265 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="810" width="226" height="70" as="geometry"/></mxCell><mxCell id="n19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;A8&lt;/b&gt; 工程ごとに次へ正しい入力を渡す（表 4.5、被覆 21.4 %）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.3.2・888 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="64" y="894" width="226" height="70" as="geometry"/></mxCell><mxCell id="n21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n4" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;B 判定&lt;/b&gt;&lt;br&gt;中核の co-design が、形態のタスク適性を正しく判定する&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ2・軸2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="180" width="250" height="96" as="geometry"/></mxCell><mxCell id="n23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;B1&lt;/b&gt; co-design を判定器に使う枠組み（Stackelberg PPO）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.1〜3.4・2,783 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="306" width="226" height="70" as="geometry"/></mxCell><mxCell id="n25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;B2&lt;/b&gt; 判定（M6）の位置づけ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.11・332 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="390" width="226" height="70" as="geometry"/></mxCell><mxCell id="n27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;B3&lt;/b&gt; 物理の値は実在の部材とアクチュエータから導いた（表 4.1・4.2）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.1.1・3,164 字 ＋ 付録D.3 554 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="474" width="226" height="70" as="geometry"/></mxCell><mxCell id="n29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;B4&lt;/b&gt; タスクと統制条件（報酬は単一項）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.1.2・814 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="558" width="226" height="70" as="geometry"/></mxCell><mxCell id="n31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;B5&lt;/b&gt; 学習のハイパーパラメータ&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.1.3・244 字 ＋ 付録D.1 551 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="642" width="226" height="70" as="geometry"/></mxCell><mxCell id="n33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;B6&lt;/b&gt; 判定器への要求 R1〜R4 と、帯で順位を言う規則&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.2・2,622 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="726" width="226" height="70" as="geometry"/></mxCell><mxCell id="n35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;B7&lt;/b&gt; R1 形を最適化することが要る&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.1・145 字（???）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="810" width="226" height="70" as="geometry"/></mxCell><mxCell id="n37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;B8&lt;/b&gt; R2 タスクを変えると収束する形が分かれる&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.2・773 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="894" width="226" height="70" as="geometry"/></mxCell><mxCell id="n39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;B9&lt;/b&gt; R3 前向き判定（届かない短腕を見分ける）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.3.1・810 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="978" width="226" height="70" as="geometry"/></mxCell><mxCell id="n41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;B10&lt;/b&gt; R3 マトリクス（順位がタスクで入れ替わる）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.3.2・1,770 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="1062" width="226" height="70" as="geometry"/></mxCell><mxCell id="n43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;B11&lt;/b&gt; R3 幾何では区別できない配分の違いを区別する&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.4.3.3・872 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="344" y="1146" width="226" height="70" as="geometry"/></mxCell><mxCell id="n45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n22" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;C 出力&lt;/b&gt;&lt;br&gt;向いていなければ、実際に使える直し方を返す&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;RQ3・軸3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="250" height="96" as="geometry"/></mxCell><mxCell id="n47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b&gt;C1&lt;/b&gt; 三層診断（幾何・収束した設計・動き）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.12・1,044 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="624" y="306" width="226" height="70" as="geometry"/></mxCell><mxCell id="n49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n46" target="n48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;C2&lt;/b&gt; 閾値は候補を出すだけで、採否は帯で決める&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;3.12.2・227 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="624" y="390" width="226" height="70" as="geometry"/></mxCell><mxCell id="n51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n46" target="n50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;C3&lt;/b&gt; 診断が学習なしで判定を再現する&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.1・1,086 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="624" y="474" width="226" height="70" as="geometry"/></mxCell><mxCell id="n53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n46" target="n52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b&gt;C4&lt;/b&gt; 助言に従わせる閉ループの組み方&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.2・241 字&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="624" y="558" width="226" height="70" as="geometry"/></mxCell><mxCell id="n55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=12;exitDy=0;" edge="1" parent="1" source="n46" target="n54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;C5&lt;/b&gt; ★ 閉ループが指針の欠陥を見つけた（実行可能性は判定の正しさと別に壊れる）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;4.5.3・256 字 ＋ 5.2.4&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#B85450;fontSize=10;align=left;spacingLeft=4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="624" y="642" width="226" height="70" as="geometry"/></mxC