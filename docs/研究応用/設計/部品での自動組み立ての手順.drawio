<mxfile host="app.diagrams.net"><diagram id="ra_flow" name="手順"><mxGraphModel dx="1200" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="部品での自動組み立ての手順（build_ra_tree.py）" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n12" value="3D 形状とチャットで決めた軸の向きから、研究室の部品（XL430・Hinge・Frame・LEGO）で組む。どの形でも同じ手順で回る" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1150" height="24" as="geometry"/></mxCell><mxCell id="n13" value="入力をつくる" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#dae8fc;strokeColor=none;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="10" y="80" width="1170" height="270" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;3D 形状&lt;/b&gt;&lt;br&gt;Gemini の絵 → Tripo の立体" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="250" height="60" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;マゼンタの球を探す&lt;/b&gt;&lt;br&gt;球の中心 → 関節の位置&lt;br&gt;断面 → リンクの太さ・先端&lt;br&gt;segment_quad_mesh.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="250" height="90" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;チャットで決めた軸の向き&lt;/b&gt;&lt;br&gt;例「股も膝も左右の水平軸」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="290" height="60" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;関節の表（SPEC）&lt;/b&gt;&lt;br&gt;鎖（脚）ごとに: 関節の位置・軸の向き・先端の点&lt;br&gt;長さは mm、胴の板の中心が原点&lt;br&gt;手で書く ／ ra_spec_from_xml.py で XML から" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="400" height="110" as="geometry"/></mxCell><mxCell id="n18" value="⚠ 軸の向きは立体から推定しない。&lt;br&gt;チャットで決めた向きを、そのまま表に書く&lt;br&gt;（四脚では quad_mesh_to_xml.py が&lt;br&gt;axis=&quot;0 1 0&quot; を書いた）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="870" y="215" width="290" height="100" as="geometry"/></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="150"/></Array></mxGeometry></mxCell><mxCell id="n22" value="下ごしらえ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#d5e8d4;strokeColor=none;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="10" y="365" width="1170" height="470" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;① 軸を ±x・±y・±z に丸める&lt;/b&gt;&lt;br&gt;（丸めた角度は出力に残す）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="405" width="400" height="55" as="geometry"/></mxCell><mxCell id="n24" value="部品は直角にしかつながらないので、斜めの軸は作れない。&lt;br&gt;ホーン（サーボの回る面）は胴の外を向く側にする" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="380" height="65" as="geometry"/></mxCell><mxCell id="n25" value="鎖の中の隣り合う&lt;br&gt;軸は平行？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="220" height="90" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;止める&lt;/b&gt;&lt;br&gt;直交の軸の鎖はまだ扱えない&lt;br&gt;（四脚の x42 で組めなかった）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="240" height="70" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;② 長さ・0° の向き・根元の狙う位置を出す&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="595" width="400" height="70" as="geometry"/></mxCell><mxCell id="n28" value="長さ ＝ 関節の間の、軸に垂直な距離&lt;br&gt;0° の向き ＝ 関節 → 次の関節（最後は → 先端）&lt;br&gt;狙う位置 ＝ 先端の面より 19 mm 外（Hinge がサーボを&lt;br&gt;挟むので、リンクの中心線がホーンより内へ寄る分）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="585" width="380" height="90" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;③ 部品どうしの相対位置の表を作る&lt;/b&gt;&lt;br&gt;「部品 A の点 p に 部品 B の点 q を&lt;br&gt;付け方 c で付けたら B はどこか」を&lt;br&gt;attach で 1 回ずつ試し、4×4 の行列で覚える" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="400" height="110" as="geometry"/></mxCell><mxCell id="n30" value="付け方 c は 4 通り: fixed・invert・rotate90・rotate-90&lt;br&gt;RobotAssembler 自身の attach を使うので、&lt;br&gt;部品の寸法を自分で書き写さなくてよい。&lt;br&gt;以降の探索は行列の掛け算だけ（速い）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="705" width="380" height="100" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n17" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="鎖（脚）ごとに組み方を選ぶ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#ffe6cc;strokeColor=none;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="10" y="850" width="1170" height="690" as="geometry"/></mxCell><mxCell id="n37" value="鎖の数だけくり返す" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;fontColor=#b46504;align=right;verticalAlign=top;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="290" y="890" width="480" height="630" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;④ リンクの型を選ぶ&lt;/b&gt;&lt;br&gt;事前に数え上げた組み方の表から、&lt;br&gt;長さがいちばん近い行（系統ごとに 1 行）&lt;br&gt;先端は Hinge ＋ ブロック 0〜8 段から近いもの" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="925" width="400" height="95" as="geometry"/></mxCell><mxCell id="n39" value="サーボ&lt;br&gt;（ホーン）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="925" width="62" height="44" as="geometry"/></mxCell><mxCell id="n40" value="Hinge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="858" y="925" width="62" height="44" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n39" target="n40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="LEGO&lt;br&gt;の段" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="936" y="925" width="62" height="44" as="geometry"/></mxCell><mxCell id="n43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n40" target="n42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n44" value="Frame" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1014" y="925" width="62" height="44" as="geometry"/></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n42" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="次の&lt;br&gt;サーボ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1092" y="925" width="62" height="44" as="geometry"/></mxCell><mxCell id="n47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n44" target="n46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n48" value="表の必須条件: 前後の軸が平行・LEGO はポッチを全部覆う・&lt;br&gt;段の継ぎ目を直交（レンガ積み）。系統 ＝ Frame とサーボのつなぎ方" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="977" width="380" height="50" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b&gt;⑤ 根元（胴の板にサーボを吊る）&lt;/b&gt;&lt;br&gt;板の穴 × フレームの角 × 付け方 × サーボの点&lt;br&gt;を総当たりし、条件でふるう&lt;br&gt;→ 狙う位置にいちばん近いもの（＋0.5 mm 以内）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1045" width="400" height="115" as="geometry"/></mxCell><mxCell id="n50" value="残す条件:&lt;br&gt;・フレームのポッチが全部、板の穴に入る&lt;br&gt;・ホーンの軸が ① の向き&lt;br&gt;・サーボが板の下&lt;br&gt;側面の外に出すときは板（plate_4_8）を 1 枚はさむ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="1050" width="380" height="105" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;⑥ 組み合わせを全部試す&lt;/b&gt;&lt;br&gt;系統 × 根元の候補 × 各 Hinge の付け方（4^関節の数）&lt;br&gt;a. 0° の姿勢を ② の向きにそろえる&lt;br&gt;b. 各関節を −30・0・+30° に振る（3^関節の数）&lt;br&gt;c. 部品のめり込みの体積を数え、最大を取る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1185" width="400" height="130" as="geometry"/></mxCell><mxCell id="n52" value="めり込み ＝ 部品の点が、別の部品の芯（表面から 1 mm&lt;br&gt;内側）に入る体積。1 mm の格子で数える。&lt;br&gt;ねじで接しているだけでも約 250 mm³ 出る。&lt;br&gt;0° をそろえる ＝ ホーンへの付け角を変えることに当たり、&lt;br&gt;部品どうしの付け方は変わらない。&lt;br&gt;⇒ Hinge の付け方が違っても、そろえた後は同じ形に&lt;br&gt;なることがある（違うのはサーボの 0° の位置だけ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="1185" width="380" height="145" as="geometry"/></mxCell><mxCell id="n53" value="めり込みが 400 mm³ より&lt;br&gt;少ない候補がある？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1335" width="300" height="105" as="geometry"/></mxCell><mxCell id="n54" value="めり込みの少ない順に 1 つ選ぶ&lt;br&gt;（同じなら 0° へそろえる回転が小さいもの）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1455" width="400" height="50" as="geometry"/></mxCell><mxCell id="n55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n38" target="n49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n49" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n51" target="n53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n58" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n53" target="n54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n59" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b46504;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n53" target="n51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="1387"/><mxPoint x="310" y="1250"/></Array></mxGeometry></mxCell><mxCell id="n60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n29" target="n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n61" value="&lt;b&gt;例: 四脚 quad_walk（1 脚）&lt;/b&gt;&lt;br&gt;根元の候補: 16〜48&lt;br&gt;試した組み合わせ: 256〜768&lt;br&gt;（系統 1〜3 × 根元 × Hinge 16）&lt;br&gt;それぞれ 9 姿勢でめり込みを数える&lt;br&gt;選んだもののめり込み: 243〜258 mm³&lt;br&gt;1 脚 1〜2 分、4 脚で部品 65 個・938 g" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#b46504;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="900" width="250" height="200" as="geometry"/></mxCell><mxCell id="n62" value="次の系統（Frame とサーボの&lt;br&gt;つなぎ方）で ⑥ をやり直す" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#b46504;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="230" height="60" as="geometry"/></mxCell><mxCell id="n63" value="組んで、確かめて、書き出す" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#e1d5e7;strokeColor=none;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="10" y="1555" width="1170" height="400" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;⑦ 本物の attach で組み直す&lt;/b&gt;&lt;br&gt;関節の間が表と 0.2 mm 以内・軸が平行かを確かめる" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1595" width="400" height="70" as="geometry"/></mxCell><mxCell id="n65" value="&lt;b&gt;書き出す&lt;/b&gt;&lt;br&gt;部品の JSON（型・姿勢・どの部分か）&lt;br&gt;.roboasm（RobotAssembler の GUI で開ける）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1690" width="400" height="85" as="geometry"/></mxCell><mxCell id="n66" value=".roboasm は RobotAssembler 自身の createRoboasm で書く。&lt;br&gt;確かめ: 読み戻して、部品ごとのつなぎ方と回転が同じか。&lt;br&gt;Body にして、関節の位置・軸・質量が JSON と同じか" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="1690" width="380" height="85" as="geometry"/></mxCell><mxCell id="n67" value="&lt;b&gt;シミュレーション用にする&lt;/b&gt;&lt;br&gt;make_quad_ra_xml.py → XML（質量・慣性は部品から合成）&lt;br&gt;export_quad_ra_body.py → .body" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#333333;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1800" width="400" height="85" as="geometry"/></mxCell><mxCell id="n68" value="今のところ関節 2 つの鎖（四脚）だけ。&lt;br&gt;関節が 3 つ以上の鎖は組めるが、&lt;br&gt;XML にする道具がまだ無い" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="1805" width="380" height="75" as="geometry"/></mxCell><mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n54" target="n64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n64" target="n65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;endArrow=block;" edge="1" parent="1" source="n65" target="n67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
